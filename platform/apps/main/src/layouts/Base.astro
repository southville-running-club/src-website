---
// One stylesheet, shared by both front doors from `packages/shared`.
//
// This is the monorepo earning its keep in miniature. Under separate repositories this
// would travel as a published package, a submodule, or — realistically — a copy that
// drifts. Here it is an import, and the two apps cannot disagree about what the club
// looks like.
import '@src/shared/styles/base.css';
import SiteBanner from '../components/SiteBanner.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteNav from '../components/SiteNav.astro';

interface Props {
  title: string;
  description: string;
  /** The address this page should be indexed under, when it has two. */
  canonical?: string;
  /**
   * An event theme, for the handful of pages that are a campaign rather than the club.
   *
   * Additive and optional: a page that does not ask for one renders exactly the markup it
   * rendered before this prop existed, because Astro drops an attribute whose value is
   * `undefined`. The theme's own stylesheet is imported by the pages that use it, not from
   * here — `build.inlineStylesheets: 'never'` then means the club's pages never fetch it.
   *
   * `nn` is Nightingale Nightmare — packages/shared/styles/nn-theme.css.
   */
  theme?: 'nn';
}

/**
 * The `masthead` slot, and why it is outside `<main>`.
 *
 * **The skip link is the whole reason.** It has always pointed at `#main`, and a navigation
 * rendered *inside* `<main>` would put the links after the thing the skip link skips to —
 * which is to say the one control that exists to jump past the navigation would land in
 * front of it. Filling this slot puts the header before `<main>`, so "Skip to content"
 * keeps meaning what it says.
 *
 * It is also what makes the header a real `banner` landmark: `<header>` maps to `banner`
 * only when it is *not* inside `main`, `article`, `aside`, `nav` or `section`. The event
 * pages' `<header class="nn-hero">` sits inside `<main>` and is therefore generic, so there
 * is exactly one banner on the page rather than two competing ones.
 *
 * **Additive, like `theme` above.** Astro renders nothing for an unfilled named slot and
 * `compressHTML` (on by default) removes the whitespace around it, so the club's own pages
 * build byte-for-byte identically to before this slot existed — verified against
 * `dist/index.html` and `dist/404.html`, not assumed. `tests/worker/serves.test.ts` is the
 * standing guard: neither page may contain `nn-theme`, `theme-nn` or `nn-nav`, which stays
 * true because neither fills this slot.
 */

const { title, description, canonical, theme } = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {
      /* The old site (southvillerunningclub.co.uk, still Squarespace) sets no theme-color
        meta tag at all, so there is nothing there to match. This is the club's own brand
        green from tokens.css's `--src-green`, not a value read off the old site. */
    }
    <meta name="theme-color" content="#00c85a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {canonical && <link rel="canonical" href={canonical} />}
    {/* Nothing here is finished, and none of it should be found in a search yet. */}
    <meta name="robots" content="noindex" />
  </head>
  <body class={theme ? `theme-${theme}` : undefined}>
    <a class="skip-link" href="#main">Skip to content</a>

    {
      /* The bar is its own component now, because `/timing` needs the same one and the two
        apps are different frameworks. Every word in it comes from `@src/shared/brand`; see
        the note at the head of `SiteBanner.astro`. */
    }
    <SiteBanner />

    {
      /* **Not on a campaign page, and that is a layout rule rather than a taste one.** The
        Nightingale Nightmare pages carry their own bar, stuck to the top, whose height is paid
        for by a hand-written `scroll-padding-top` token per breakpoint — ADR-014. A second bar
        above it moves every anchor and every keyboard focus behind the header at every width,
        with nothing visibly wrong; that is the defect ADR-014 exists to answer, and renaming a
        single label once was enough to cause it.

        `theme` is the discriminator because those pages already carry it, so this cannot be
        forgotten on a new one the way an opt-out prop could be. They keep their route home:
        `NnMasthead`'s club wordmark has linked to `/` since it was written. */
    }
    {theme !== 'nn' && <SiteNav />}

    <slot name="masthead" />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
