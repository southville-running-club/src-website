---
import ClubBase from '../layouts/ClubBase.astro';
import { parseCommittee, parseLinks } from '@src/shared/club-content';
import committee from '../content/committee.json';
import links from '../content/links.json';

// `/about/` — who the club is, who runs it, and where its documents are.
//
// ## The committee is people now, with a face each
//
// ⚠️ **This section named nobody until 27 September 2026.** A committee member's name — and a
// photograph more so — is personal data the club publishes about a volunteer, so the page
// showed roles only until the club supplied the list. It has now, with each person's consent,
// and `committee.json` holds a name, a role and a photo for every one of them. A role change
// at the AGM is an edit to that file; a new face is a 480×480 WebP in
// `public/images/committee/`. `club-content.test.ts` fails if a named photo is not on disk.
//
// **The welfare officers are in the panel and nowhere else.** They are a list of their own in
// `committee.json` rather than a flag on a volunteer, so the page cannot render them twice.
//
// ## Two email addresses, and no trip to the old site
//
// Until 28 September 2026 every route to a human on this page went through the old site's
// committee page, because the club had not confirmed any addresses. **Contact us** now gives
// `info@southvillerunningclub.co.uk`, the club's general address, which `/privacy/` and the
// ticket emails already publish. Other pages still link to the old committee page through
// `links.json`'s `committee` entry; this page no longer reads it.
//
// ⚠️ **The welfare panel has its own address, since 28 September 2026.** The club supplied
// `welfare@southvillerunningclub.co.uk`, so the button is a `mailto:` for that address rather
// than a trip to the old site with an instruction to ask for somebody when you get there — the
// best the panel could honestly say before, and a poor thing to ask of a person who needs a
// welfare officer now. The address is also printed under the button, because a `mailto:` does nothing
// on a machine with no mail client and somebody has to be able to copy it. It carries `<wbr>`
// after the `@` and each `.`, so 38 unbroken characters cannot push a 320px page sideways.
//
// ## Club documents
//
// Grouped as the mockup groups them, but **only the groups whose documents actually have a
// home**. Governance and Policies are named because they exist and are findable on the old
// site; the meeting-minutes accordion — twelve years of "[AGM and QGM minutes, 2019]" — is a
// list of placeholders, so it is one link to the documents page instead.

const { officers, volunteers, welfare } = parseCommittee(committee);

/** Every committee photograph lives here, named by `committee.json`'s `photo`. */
const PHOTOS = '/images/committee/';
const { 'club-documents': documents } = parseLinks(links);

/** The welfare officers' address — supplied by the club, 28 September 2026. */
const WELFARE_EMAIL = 'welfare@southvillerunningclub.co.uk';

/** The club's general address, already published on `/privacy/` and in the ticket emails. */
const INFO_EMAIL = 'info@southvillerunningclub.co.uk';

const GOVERNANCE = ['Constitution', 'Articles of Association'];

const POLICIES = [
  'Inclusion policy',
  'Health and safety policy and risk assessment',
  'Disciplinary and grievance policy',
  'Welfare policy',
  'Adult safeguarding policy',
  'Code of conduct: senior athletes',
  'England Athletics guide to managing disputes',
];
---

<ClubBase
  title="About the club — Southville Running Club"
  description="A friendly running club in South Bristol since 2007. Mixed abilities and ages 18+, run by volunteers."
  canonical="https://new.southvillerunningclub.co.uk/about/"
>
  <header class="club-phead">
    <div class="club-wrap">
      <h1>A friendly club since 2007</h1>
      <p class="club-lede">
        Mixed abilities and ages 18+, running together in South Bristol. Run by
        volunteers, for everyone who fancies it.
      </p>
    </div>
  </header>

  <section class="club-sec">
    <div class="club-wrap club-g2 club-split">
      <div>
        <h2>Questions people ask</h2>
        <div class="club-acc">
          <details open>
            <summary>Who are we?</summary>
            <div class="club-acc-body">
              <p>
                A friendly club founded in 2007. Some of us run or walk 5km, some enjoy
                social runs round South Bristol, and some are chasing race times.
              </p>
            </div>
          </details>
          <details>
            <summary>What happens after the run?</summary>
            <div class="club-acc-body">
              <p>
                Drinks at the Southbank Club, plus regular socials. Keep an eye on
                Facebook.
              </p>
            </div>
          </details>
          <details>
            <summary>Do I need hi-viz?</summary>
            <div class="club-acc-body">
              {
                /* ⚠️ **"From autumn", not a month.** Whether it becomes compulsory in
                  September or October is not confirmed, so the page says the true, vaguer
                  thing rather than picking one and being wrong for a month every year. */
              }
              <p>
                Yes, from autumn until the clocks go forward in spring. We have spares to
                borrow.
              </p>
            </div>
          </details>
          <details>
            <summary>Can I cycle there?</summary>
            <div class="club-acc-body">
              <p>Yes. Bikes can be locked in the garden behind the Southbank Club.</p>
            </div>
          </details>
          <details>
            <summary>Where do I leave my bag?</summary>
            <div class="club-acc-body">
              <p>
                There's bag storage from 6.00 to 6.15pm, but it isn't secure. The
                Southbank Club rents lockers for a £5 deposit.
              </p>
            </div>
          </details>
          <details>
            <summary>Do people race?</summary>
            <div class="club-acc-body">
              <p>
                Some run for fun and fitness. Many race on road and trail, in the UK and
                abroad.
              </p>
            </div>
          </details>
          <details>
            <summary>How do I keep up with club news?</summary>
            <div class="club-acc-body">
              <p>
                Read <a href="/news/">the monthly newsletter</a>, and come on a Tuesday.
              </p>
            </div>
          </details>
        </div>
      </div>

      {
        /* ⚠️ **A flat panel, `aria-hidden`, with nothing written on it.** The mockup drew a
          striped box captioned "[Photo: the Tuesday crowd outside the Southbank Club]".
          Neither the stripes nor the caption ship — a stripe reads as a broken image and the
          bracket is the placeholder this build may not publish. When the club supplies
          photographs, with consent from the people in them, this is replaced rather than
          filled in. */
      }
      <div class="club-photo club-photo-tall" aria-hidden="true"></div>
    </div>
  </section>

  <section class="club-sec club-sec-alt club-committee" aria-labelledby="committee">
    <div class="club-wrap">
      <h2 id="committee">The committee</h2>
      <p class="club-lede">
        Everyone here is a volunteer. If you'd like to help, talk to any of us on a
        Tuesday.
      </p>

      {
        /* ⚠️ **`alt=""` on every photograph, deliberately.** The person's name is the heading
          right beside it, so a descriptive alt — "Photo of Amy Webb" — would be read out twice
          and tell a screen-reader user nothing the heading had not. `width` and `height` are
          set so the space is reserved before the image arrives; the whole section is below
          the fold, so every one is lazy. */
      }
      <h3>Officers</h3>
      <ul class="club-people">
        {
          officers.map((person) => (
            <li class="club-person">
              <img
                src={`${PHOTOS}${person.photo}`}
                alt=""
                width="128"
                height="128"
                loading="lazy"
                decoding="async"
              />
              <h4>{person.name}</h4>
              <p class="club-role">{person.role}</p>
            </li>
          ))
        }
      </ul>

      <h3>Volunteers</h3>
      <ul class="club-people">
        {
          volunteers.map((person) => (
            <li class="club-person">
              <img
                src={`${PHOTOS}${person.photo}`}
                alt=""
                width="128"
                height="128"
                loading="lazy"
                decoding="async"
              />
              <h4>{person.name}</h4>
              <p class="club-role">{person.role}</p>
            </li>
          ))
        }
      </ul>

      <div class="club-welfare-panel">
        <div>
          <div class="club-welfare-head">
            {/* A speech bubble. Decoration: the heading beside it says it in words. */}
            <span class="club-welfare-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" focusable="false">
                <path
                  d="M4 5.5A1.5 1.5 0 0 1 5.5 4h13A1.5 1.5 0 0 1 20 5.5v9a1.5 1.5 0 0 1-1.5 1.5H9l-4 3.5V16H5.5A1.5 1.5 0 0 1 4 14.5z"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linejoin="round"></path>
              </svg>
            </span>
            <h3>Need to talk to someone?</h3>
          </div>
          <p>
            Our welfare officers are here, in confidence, for anything that's worrying you
            about the club.
          </p>
          <p class="club-welfare-action">
            <a class="club-btn club-btn-primary" href={`mailto:${WELFARE_EMAIL}`}>
              Contact a welfare officer
              <svg
                aria-hidden="true"
                focusable="false"
                viewBox="0 0 24 24"
                width="18"
                height="18"
              >
                <path
                  d="M5 12h13M13 6l6 6-6 6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.25"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </a>
          </p>
          <p class="club-small">
            Or email us at welfare@<wbr />southvillerunningclub.<wbr />co.<wbr />uk.
          </p>
        </div>

        <ul class="club-welfare-people">
          {
            welfare.map((person) => (
              <li class="club-welfare-person">
                <img
                  src={`${PHOTOS}${person.photo}`}
                  alt=""
                  width="96"
                  height="96"
                  loading="lazy"
                  decoding="async"
                />
                <div>
                  <h4>{person.name}</h4>
                  <p class="club-role">{person.role}</p>
                  <p class="club-confidence">
                    <svg
                      aria-hidden="true"
                      focusable="false"
                      viewBox="0 0 24 24"
                      width="14"
                      height="14"
                    >
                      <rect
                        x="5"
                        y="11"
                        width="14"
                        height="9"
                        rx="1.5"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                      />
                      <path
                        d="M8 11V8a4 4 0 0 1 8 0v3"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                      />
                    </svg>
                    Talk to us in confidence
                  </p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="club-sec" id="documents">
    <div class="club-wrap club-g2 club-split">
      <div>
        <h2>Club documents</h2>
        <p>
          {
            /* ⚠️ `{' '}`: Prettier puts the newline before the link and Astro compresses it
            to nothing, rendering "live onour old site". Same trap as "BristolBS3 1DB". */
          }
          The club's governing documents and policies live on{' '}
          <a href={documents.href}>our old site</a> for now.
        </p>

        <h3>Governance</h3>
        <ul class="club-docs">
          {
            GOVERNANCE.map((name) => (
              <li>
                <a href={documents.href}>{name}</a>
              </li>
            ))
          }
        </ul>

        <h3>Policies</h3>
        <ul class="club-docs">
          {
            POLICIES.map((name) => (
              <li>
                <a href={documents.href}>{name}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2>Meeting minutes</h2>
        {
          /* ⚠️ **One link, not twelve years of accordions.** The mockup lists 2015 to 2026,
            and every entry under them is "[AGM and QGM minutes, 2019]" — a placeholder per
            year. Until the club supplies which minutes exist and where they are, a year with
            nothing behind it is a promise the page cannot keep. */
        }
        <p>
          Minutes from the club's AGMs and quarterly meetings are published with the rest
          of the club's documents.
        </p>
        <p>
          <a class="club-btn club-btn-secondary" href={documents.href}>
            {documents.label} on our old site
          </a>
        </p>
      </div>
    </div>
  </section>

  <section class="club-sec club-sec-alt" id="contact">
    <div class="club-wrap">
      <h2>Contact us</h2>
      <p>
        The quickest way to reach anybody on the committee — membership, welfare, kit or
        anything else — is to email <a href={`mailto:${INFO_EMAIL}`}
          >info@<wbr />southvillerunningclub.<wbr />co.<wbr />uk</a
        >.
      </p>
      <p>Or just come and say hello on a Tuesday.</p>
    </div>
  </section>
</ClubBase>
