---
import Base from '../../layouts/Base.astro';
import NnMasthead from '../../components/NnMasthead.astro';
import NnEntryForm from '../../components/NnEntryForm.astro';
import race from '../../content/race.json';

// The Nightingale Nightmare event theme — the campaign look, and nothing the campaign
// knows that this site does not. See packages/shared/styles/nn-theme.css.
import '@src/shared/styles/nn-theme.css';

// Still says nothing about the race that nobody has confirmed.
//
// **The date arrived, and it arrived as a one-line edit to `src/content/race.json` with no
// change to this file at all.** That was the property the arrangement was built for and it
// is worth recording that it held: `race.date` and `race.startTime` went from `null` to
// values, and the date line, the facts list below and three new pages picked them up
// without a line of markup moving.
//
// What is still `null` is still genuinely undecided rather than merely unwritten. `price` and
// `entriesOpen` stay `null` here for a different reason from the rest: **they are the
// database's**. The fees live in `entries.fees.price_pence` and the window in
// `entries.events`, and the Worker paints them onto the entry form — a second copy in this
// file is how two numbers start disagreeing. The opening time nobody has decided, and the
// 2026 ARC permit number has not been issued. Inventing any of them here is a "stop and ask"
// trigger, not a placeholder.
//
// See docs/architecture/principles.md#stop-and-ask

// One address, and it is a path rather than a subdomain — so at the Squarespace cutover
// the hostname changes and this page does not move.
const canonical = 'https://new.southvillerunningclub.co.uk/nn/';

// An absent fact is stated as absent. A blank cell reads as an oversight and an invented
// value reads as a promise; "To be confirmed" is the only honest third option, and it is
// what somebody deciding whether to come back next week actually needs to know.
const orTbc = (fact: string | null): string => fact ?? 'To be confirmed';

// **The one sentence about when this race happens.**
//
// It is now `race.date` — Sunday 1 November 2026, settled by the club's published campaign
// artwork and confirmed by the maintainer. The fallback stays because it costs one `??` and
// it is the honest thing to render if a future edit ever empties the field again: a blank
// date line reads as a page that failed to load, and the qualifier belongs welded to the
// claim rather than styled smaller beside it.
//
// **The start time joins it now that both are confirmed**, which is what the campaign
// artwork does and what somebody actually wants from one line. It is composed rather than
// stored as a third field, so there is still exactly one place a date lives.
const dateLine = race.date
  ? `${race.date}${race.startTime ? ` · ${race.startTime}` : ''}`
  : 'Halloween weekend 2026 — exact date to be confirmed';
---

<Base
  title="Nightingale Nightmare — register your interest"
  description="Register your interest in Nightingale Nightmare and the club will email you once, when entries open."
  canonical={canonical}
  theme="nn"
>
  <NnMasthead slot="masthead" />

  <header class="nn-hero">
    <div class="nn-wrap">
      {
        /* **"presents…" opens the hero now that the wordmark has moved to the masthead.**
        The sentence it belongs to still reads the same way down the page — "Southville
        Running Club" in the header, then "presents…", then the title — which is what
        somebody seeing it gets and, because the header is the first thing in the DOM, what
        somebody hearing it gets too. */
      }
      <p class="nn-presents">presents…</p>

      <h1>{race.name}</h1>

      <p class="nn-dateline">{dateLine}</p>

      {
        /* **The three answers somebody wants before they read a sentence.** A real list,
        because that is what it is, with the bullets taken off — a screen reader still says
        "list, three items" and gets the same summary a sighted reader gets from the row.

        The mockup has a fourth item here, a live "238 of 250 places remaining" bar. That is
        demo data, and the database could answer it now — but a number that is wrong within a
        day of anybody entering, cached at the edge and read off a poster-shaped page, is a
        claim the club would have to keep true. How big the race is does not change, so that
        is what this says. Somebody who tries to enter a full race is told plainly, on the
        form, at the moment it matters. */
      }
      <ul class="nn-facts">
        <li>{race.distance}</li>
        <li>{race.places} places</li>
        <li>Fancy dress encouraged</li>
      </ul>

      <p class="lede">
        The club is putting on this race again. The date is settled and the course has not
        got any kinder — what is not settled is what it costs and when entries open. Leave
        your name and the club will email you once, when they do.
      </p>

      {
        /* **The loud button is the one this site can actually honour.** The mockup's is
        "Enter the race — from £15", which is a price nobody has confirmed attached to a
        payment flow that does not exist. Registering interest is the whole of what this
        page does, so it is the whole of what the primary control offers. */
      }
      {
        /* **The button says the one thing this page can honour today**, and the Worker
        changes it to "Enter the race" on the day `entries.events.entries_open_at` says
        entries are open. That is one row edit and no deploy, which is the property the
        event table exists for — and it is why the label and the target are painted on
        rather than written in. */
      }
      <div class="nn-herobtns">
        <a class="nn-cta" href="#register" data-nn-cta>Register your interest</a>
        <a class="nn-ghost" href="/nn/race-day/">Race-day plan</a>
      </div>
    </div>
  </header>

  <div class="nn-wrap">
    <h2>The race</h2>

    <p>
      Everything here is confirmed by the committee before it appears. Anything still
      reading "to be confirmed" is genuinely undecided rather than merely unwritten.
    </p>

    <dl class="status">
      <dt>Date</dt>
      <dd>{orTbc(race.date)}</dd>

      <dt>Start time</dt>
      <dd>{orTbc(race.startTime)}</dd>

      <dt>Distance</dt>
      <dd>{orTbc(race.distance)}</dd>

      <dt>Race HQ</dt>
      <dd>{orTbc(race.location)}</dd>

      {
        /* **The field size, not how much of it is left** — see the note on the hero row.
        250 is how big the race is, and it does not change during the week somebody is
        deciding whether to come. */
      }
      <dt>Field size</dt>
      <dd>{race.places} places</dd>

      <dt>Entry fee</dt>
      <dd>{orTbc(race.price)}</dd>

      <dt>Entries open</dt>
      <dd>{orTbc(race.entriesOpen)}</dd>

      {
        /* **Null, and it stays null until a number is issued.** The 2023 permit number is
        on record and it belongs to the 2023 race; putting it here would be a claim that
        this year's race is permitted, which is a different sort of wrong from a typo. */
      }
      <dt>ARC permit</dt>
      <dd>{orTbc(race.permit)}</dd>
    </dl>

    {
      /* **A summary that ends in a link, not a second copy of the course page.** Four
      things somebody should know before they leave their name, and then the page that
      says the rest. The mockup has a fifth line here — "Minimum age 18 on race day" —
      which is inferred from the prize categories rather than stated as a rule anywhere,
      and is still an open decision. It is not here, and it is not softened into "18+
      probably" either. */
    }
    <div class="nn-card nn-prose">
      <h2>Know what you are in for</h2>

      <ul class="nn-arrows">
        <li>
          A tough, properly off-road course — uneven, rocky, rooty, and slippery when wet.
          <strong>Trail shoes recommended</strong>, road shoes acceptable.
        </li>
        <li><strong>No headphones of any type during the race.</strong></li>
        <li>
          One water station on the route, one at the finish, and marshals throughout.
        </li>
        <li>
          <strong>The start and the finish are not at race HQ.</strong> Everybody walks down
          together at 10:30, so there is nothing to find on your own.
        </li>
      </ul>

      <p>
        <a href="/nn/course/">The course and terrain, in full</a> — and{' '}
        <a href="/nn/race-day/">the whole running order for the day</a>.
      </p>
    </div>

    {
      /* ------------------------------------------------------------------------------
       * The two states of this page, and which one somebody gets
       * ------------------------------------------------------------------------------
       * **Both are in the HTML; the Worker reveals one.** Which one is decided by
       * `entries.events.entries_open_at` and `entries_close_at`, read at request time
       * through `entries.entry_state()` — so entries open when the committee says they do,
       * by a row edit, not by somebody being available to deploy at seven in the morning.
       *
       * **The interest form ships visible and the entry form ships hidden**, which is the
       * safe default rather than an arbitrary one. If the Worker cannot reach the database
       * at all, this page falls back to the form that was already here and that takes no
       * money — a page that cannot tell whether entries are open must not offer to take an
       * entry. See `worker/nn-entry.ts`.
       * ------------------------------------------------------------------------------ */
    }

    <div data-nn-interest>
      <h2 id="register">Register your interest</h2>

      {
        /* The acknowledgement, the failure notice and the error summary are all served hidden
      and revealed by the Worker — see worker/nn-signup.ts. Doing it this way means there is
      exactly one copy of this page, in dist/, and the Worker paints an outcome onto it
      rather than holding a second template that can drift from this one.

      Each carries `tabindex="-1"` so the Worker can add `autofocus` and move focus to it.
      That is how focus moves **with JavaScript disabled**, which is the primary path here
      rather than a fallback.

      All three are white cards in the event theme, because all three are read rather than
      glanced at, and none of them lets colour carry the meaning: each says in words what it
      is. */
      }

      <div
        class="notice notice-ok nn-card"
        data-signup-ack
        hidden
        tabindex="-1"
        role="status"
      >
        {
          /* The mockup's confirmation tick. Decorative, and hidden from assistive technology
        deliberately — this element is a live region, and what should be announced is the
        sentence below, not the word "tick". */
        }
        <span class="nn-tick" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false"
            ><path d="M4 12.5 10 18 20 6"></path></svg
          >
        </span>
        <p><strong>Thank you — your interest is registered.</strong></p>
        <p>
          The club will email you once, when entries open. That is the only thing this
          list is used for.
        </p>
      </div>

      <div
        class="notice notice-bad nn-card"
        data-signup-unavailable
        hidden
        tabindex="-1"
        role="alert"
      >
        <p><strong>Sorry — that could not be saved just now.</strong></p>
        <p>
          Nothing has been recorded, and nothing you typed has been lost. Please press
          "Register my interest" again in a moment.
        </p>
      </div>

      <div
        class="notice notice-bad nn-card"
        data-signup-summary
        hidden
        tabindex="-1"
        role="alert"
      >
        <h3>There is a problem</h3>
        <ul class="summary-list">
          <li data-signup-summary-item="name" hidden>
            <a data-signup-summary-link="name" href="#signup-name"></a>
          </li>
          <li data-signup-summary-item="email" hidden>
            <a data-signup-summary-link="email" href="#signup-email"></a>
          </li>
          <li data-signup-summary-item="consent" hidden>
            <a data-signup-summary-link="consent" href="#signup-consent"></a>
          </li>
        </ul>
      </div>

      {
        /* **Above the form, not below it.** What happens to a name and an email address is
      worth knowing before typing them rather than after, and somebody who wants to check
      first should not have to scroll past the thing they are deciding about to find out. */
      }

      <p class="signup-privacy">
        The club holds your name and email address, and uses them for nothing but this one
        email. <a href="/nn/privacy/">What the club does with this</a>, including how to
        have it removed.
      </p>

      {
        /* A real form, posting to a real address. No JavaScript is involved in submitting it,
      validating it, or rendering what comes back — runners are on phones, on poor signal,
      sometimes in bright sunlight with cold hands.

      `action` carries the trailing slash Astro is configured to insist on, so a submission
      never arrives at a second address for the same page. */
      }

      <form class="signup nn-card" method="post" action="/nn/">
        {
          /* Which of this page's two forms arrived. Stated on both, so neither is identified
        by the absence of something — a stale cached page with no `form` field is still read
        as the interest form, which is the harmless direction. */
        }
        <input type="hidden" name="form" value="interest" />

        <div class="field">
          <label class="field-label" for="signup-name">Your name</label>
          <p class="field-error" id="signup-name-error" data-signup-error="name" hidden>
          </p>
          <input
            class="field-input"
            id="signup-name"
            name="name"
            type="text"
            maxlength="100"
            autocomplete="name"
            required
            aria-describedby="signup-name-error"
            data-signup-value="name"
          />
        </div>

        <div class="field">
          <label class="field-label" for="signup-email">Email address</label>
          <p class="field-hint" id="signup-email-hint">
            The club will email you once, when entries open.
          </p>
          <p class="field-error" id="signup-email-error" data-signup-error="email" hidden>
          </p>
          <input
            class="field-input"
            id="signup-email"
            name="email"
            type="email"
            maxlength="254"
            autocomplete="email"
            spellcheck="false"
            required
            aria-describedby="signup-email-hint signup-email-error"
            data-signup-value="email"
          />
        </div>

        <div class="field">
          <p
            class="field-error"
            id="signup-consent-error"
            data-signup-error="consent"
            hidden
          >
          </p>
          <div class="field-check">
            {
              /* **`required` is one half of the consent decision.** Consent is currently
            required to submit; the other half is `z.literal(true)` in
            packages/shared/src/nn-signup.ts. If the committee decides an unconsented
            submission should be stored instead, remove `required` here and change that to
            `z.boolean()`. No migration is involved — the policy's `with check` is
            deliberately silent on consent. */
            }
            <input
              class="field-checkbox"
              id="signup-consent"
              name="consent"
              type="checkbox"
              required
              aria-describedby="signup-consent-error"
              data-signup-value="consent"
            />
            <label class="field-label" for="signup-consent">
              Yes, email me when entries open for this race.
            </label>
          </div>
        </div>

        <button class="button" type="submit">Register my interest</button>
      </form>
    </div>

    <div data-nn-entry hidden>
      <NnEntryForm />
    </div>

    {
      /* **The "What this page proves" block was here, and it is gone.**
       *
       * A `<dl>` of the database timestamp, a pipeline-check marker, "Served by: Cloudflare
       * Workers, static assets plus one handler" and "Application: apps/main" — directly
       * below the form somebody hands over £17 and their emergency contact on.
       *
       * Every one of those round trips is still made, still by this Worker, still in the real
       * runtime, and the smoke test still fails the deploy if either breaks. They are answered
       * at `/_health` now, as JSON. **The check was never the problem; its audience was** — this
       * page's reader is a runner deciding whether the club can be trusted with a card number,
       * and a page that reports its own plumbing reads as a page that is not finished.
       *
       * See `packages/shared/src/health-report.ts` and `worker/index.ts`. */
    }

    <footer>
      <p>
        Southville Running Club. Anything above reading "to be confirmed" is with the
        committee, and this page is updated when it is settled.
      </p>
      <p>
        Questions? <a href={`mailto:${race.contact}`}>{race.contact}</a>
      </p>
      <p>
        <a href="/nn/privacy/">What the club does with your details</a>
      </p>
    </footer>
  </div>

  {
    /* The club's own artwork, at the foot of the page. **Empty on purpose** — it is a CSS
    background, not an `<img>`, because it is decoration that states nothing and because an
    image with intrinsic dimensions is briefly 1080 pixels wide before the stylesheet lands.
    See the artwork section of nn-theme.css. */
  }
  <div class="nn-hands" aria-hidden="true"></div>
</Base>
