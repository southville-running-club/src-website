---
interface Props {
  /**
   * One race's own links, for the pages that are about one running.
   *
   * **Passed in rather than written here, because this footer is on every page of this app** —
   * the sign-in screen, the roles page, `/privacy/`. More sharply, it is on `/nn/`, which
   * [ADR-011](../../../../docs/architecture/decisions/adr-011-a-race-and-its-runnings.md)
   * requires to name no year anywhere in its markup, and `/nn/2026/terms/` is an href with a
   * year in it. The terms are year-scoped for a real reason:
   * `entry_purchases.consents_version` records which wording somebody ticked against.
   *
   * **Grouped under the race's name rather than merged into the legal line, and that is the
   * whole design decision here.** A race carries its own privacy notice — what an entry and a
   * sign-up collect — and the club carries the club's. Side by side in one row they read as
   * two links called roughly the same thing, and nothing on screen says which is which. Under
   * the race's name, one of them is obviously the race's and the other obviously is not.
   */
  race?: {
    /** As it is titled, so a reader knows whose links these are. */
    name: string;
    /**
     * The year-scoped entry terms and race rules, from the pages that belong to one running.
     *
     * **Optional, and `/nn/` is why** — the paragraph above described that page as the sharp
     * case before it was one. It is the race rather than a running of it, so it may not name a
     * year in its markup, and this href does. It passes `name`, `privacy` and `contact` and
     * omits this; the row below renders whatever it was given.
     *
     * **Omitted rather than pointed somewhere year-free**, because there is nowhere to point.
     * The terms are year-scoped for a real reason — `entry_purchases.consents_version` records
     * which wording somebody ticked against — so an evergreen "the entry terms" link would have
     * to resolve to a running, which is a redirect this site has no mechanism for and a claim
     * about which year's wording binds.
     */
    terms?: string;
    /** The race's privacy notice, which is not the club's. */
    privacy: string;
    /** Where a question about this race goes. */
    contact: string;
  };
}

const { race } = Astro.props;

// The one footer, rendered on every page from `Base.astro`.
//
// Just the club's social profiles for now — the old site carried these as a row of icon
// links reachable from every page, and that is the one piece of it this rebuild replaces
// so far. Everything else on the old footer (membership links, documents, newsletters) is
// still on `southvillerunningclub.co.uk`; see `SITE_BANNER` for the link back there.
//
// **Icons, not words, matching the old site and industry practice for a social-links row.**
// The addresses and the artwork both come from `@src/shared/social` now rather than from
// four `?raw` imports here: `/timing` carries the same footer and is a Next app, where
// Vite's `?raw` does not exist. `apps/timing/app/site-footer.tsx` is this file's opposite
// number, and the two cannot drift because neither owns the list.
//
// Each path is filled with `currentColor` the same way `ClubLogo.astro` fills the wordmark
// — one colour decision, made in CSS, rather than baked into borrowed artwork.
//
// **And one line of words: the club's privacy notice.** A notice is only a notice if it can
// be found without already knowing it exists, which means every page rather than only the
// pages that collect something — a person deciding whether to create an account is exactly
// the person who has not filled anything in yet. `apps/timing/app/site-footer.tsx` carries
// the same link for the same reason; the two files are the honest price of Astro on one side
// of the hostname and Next on the other.
import { SOCIAL_ICON_VIEWBOX, SOCIAL_LINKS } from '@src/shared/social';
---

<footer class="site-footer">
  <p class="site-footer-heading">Follow the club</p>
  <ul class="site-footer-social">
    {
      SOCIAL_LINKS.map((link) => (
        <li>
          <a href={link.href} aria-label={link.name}>
            <svg
              viewBox={SOCIAL_ICON_VIEWBOX}
              width="24"
              height="24"
              aria-hidden="true"
              focusable="false"
            >
              <path d={link.d} fill="currentColor" />
            </svg>
          </a>
        </li>
      ))
    }
  </ul>
  {
    race !== undefined && (
      <>
        <p class="site-footer-heading site-footer-race-heading">{race.name}</p>
        <ul class="site-footer-links">
          {race.terms !== undefined && (
            <li>
              <a href={race.terms}>Entry terms and race rules</a>
            </li>
          )}
          <li>
            <a href={race.privacy}>What the club does with your details</a>
          </li>
          <li>
            <a href={`mailto:${race.contact}`}>{race.contact}</a>
          </li>
        </ul>
      </>
    )
  }
  <p class="site-footer-legal"><a href="/privacy/">Privacy notice</a></p>
</footer>
