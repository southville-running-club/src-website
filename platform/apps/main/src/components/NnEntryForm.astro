---
import race from '../content/race.json';

/**
 * The Nightingale Nightmare entry form.
 *
 * **One page, not a wizard.** A multi-step flow needs either JavaScript or somewhere on the
 * server to keep a half-finished entry, and this site has neither by design: the form works
 * with scripting off as its primary path, and there is no session store to add. So it is one
 * page, grouped into seven `<fieldset>`s, and everything is visible at once.
 *
 * **Nothing here knows a price.** The three fee cards ship with their labels and prices
 * empty and `hidden`; the Worker fills in whichever the event is actually offering, from
 * `entries.fees` via `entries.entry_state()`. A price written into this markup would be a
 * second copy of a number that lives in one place on purpose — see the migration.
 *
 * **The fee codes are known here, and that is deliberate rather than sloppy.** The
 * `entries.fees.code` check constraint is a closed list, so adding one is already a reviewed
 * migration; it costing a deploy as well is the honest price of the Worker painting values
 * onto one static page rather than assembling markup from data.
 * `setInnerContent(..., { html: true })` is what the alternative would need, and there is
 * deliberately no such call anywhere in this repository to audit.
 *
 * **`complimentary` is on that list and deliberately has no card here.** It is a £0 fee
 * gated by `requires_permission = 'nn.entry.create'`, so `entry_state()` never returns it to
 * a runner and `create_pending_purchase()` refuses it — a place on it is *given* from
 * `/admin/nn/` rather than bought from this page. Adding a card for it would be offering
 * everybody a free entry that the database would then refuse.
 *
 * Every `data-entry-*` hook is read by `worker/nn-entry.ts`. See that file for what is
 * painted onto which.
 */

// The order on the page is the page's, and it is the mockup's: the affiliated entry first,
// then everyone else, then the guide's place. `entry_state()` returns fees in its own stable
// order for anything rendering from the array; nothing renders this list from data.
const FEES = [
  {
    code: 'affiliated',
    // **A statement the runner makes, and nothing asks them to prove it.** The club stopped
    // asking for England Athletics numbers on 29 August 2026 — see the note by the entry-type
    // fieldset below — so this description is the whole of the question. What the club keeps
    // is the right to ask, which is said in the privacy notice rather than here: a form that
    // repeated it beside the radio would be reading as a threat over £2.
    description: 'You hold a current England Athletics registration through a club.',
  },
  {
    code: 'unaffiliated',
    // **No price and no difference-in-price in this string.** The mockup's version explains
    // the gap in pounds; both numbers live in `entries.fees` and a third copy of either
    // here would be a price the database could not correct. `serves.test.ts` asserts that
    // no `£` figure appears in `dist/` at all, and it is right to.
    description: 'Everybody else, and just as welcome.',
  },
  {
    // **Last, and invisible to everybody who is not testing.** Every card in this list ships
    // `hidden` and is revealed only when `entry_state()` returns a fee with that code — and
    // `entries.fees.requires_permission` keeps this one out of that answer for anybody
    // without `nn.entry.before_open`. So the markup existing is not the same as the card
    // existing, exactly as it already is for a fee the committee withdraws.
    //
    // It is at the end because it is the only one whose order does not matter: nobody
    // choosing between entry types will ever see it beside another.
    code: 'tester',
    description:
      'Checks that a real card payment reaches the club. Not an entry to the race.',
  },
] as const;

/**
 * The error summary lists problems in the order somebody meets them scrolling down, and
 * each link lands on the input the message is about. `dateOfBirth` points at the day box —
 * the first of the three — because that is where a correction starts.
 */
const SUMMARY_LINKS = [
  ['firstName', 'entry-first-name'],
  ['lastName', 'entry-last-name'],
  ['email', 'entry-email'],
  ['emailConfirm', 'entry-email-confirm'],
  ['phone', 'entry-phone'],
  ['dateOfBirth', 'entry-dob-day'],
  ['gender', 'entry-gender'],
  ['genderIdentity', 'entry-gender-identity'],
  ['club', 'entry-club'],
  ['feeCode', 'entry-fee-affiliated'],
  ['discountCode', 'entry-discount-code'],
  ['emergencyName', 'entry-emergency-name'],
  ['emergencyPhone', 'entry-emergency-phone'],
  ['viGuide', 'entry-vi-guide'],
  ['guideFirstName', 'entry-guide-first-name'],
  ['guideLastName', 'entry-guide-last-name'],
  ['guideDateOfBirth', 'entry-guide-dob-day'],
  ['guideEmail', 'entry-guide-email'],
  ['guideEmergencyName', 'entry-guide-emergency-name'],
  ['guideEmergencyPhone', 'entry-guide-emergency-phone'],
  ['medicalNotes', 'entry-medical-notes'],
  ['guideMedicalNotes', 'entry-guide-medical-notes'],
  ['medicalConsent', 'entry-medical-consent'],
  ['entryTerms', 'entry-terms'],
] as const;
---

<h2 id="enter">Enter the race</h2>

{
  /* The three outcomes this form can meet, all served hidden and revealed by the Worker —
  the same arrangement the interest form uses, and for the same reason: there is one copy of
  this page, in `dist/`, and the Worker paints an outcome onto it rather than holding a
  second template that can drift.

  Each carries `tabindex="-1"` so the Worker can add `autofocus` and move focus to it. That
  is how focus moves **with JavaScript disabled**, which is the primary path here. */
}

<div
  class="notice notice-bad nn-card"
  data-entry-summary
  hidden
  tabindex="-1"
  role="alert"
>
  <h3>There is a problem</h3>
  <ul class="summary-list">
    {
      SUMMARY_LINKS.map(([field, target]) => (
        <li data-entry-summary-item={field} hidden>
          <a data-entry-summary-link={field} href={`#${target}`} />
        </li>
      ))
    }
  </ul>
</div>

{
  /* **The honest answer when there is no payment key to send anybody to.** That is the
  deployed state today: `STRIPE_SECRET_KEY` is a Worker secret and it has not been set. The
  Worker checks it *before* it holds a place, so this notice's claim that nothing was stored
  is literally true rather than nearly true. A valid submission is never quietly acknowledged
  as an entry — that would be the one failure worth more than all the others put together. */
}
<div
  class="notice notice-bad nn-card"
  data-entry-unavailable
  hidden
  tabindex="-1"
  role="alert"
>
  <p><strong>Your entry is not finished — payment is not connected yet.</strong></p>
  <p>
    Everything you typed passed the club's checks, and <strong
      >nothing has been stored and nothing has been charged</strong
    >. Entries cannot be completed until the payment step is switched on.
  </p>
  <p>Nothing you typed has been lost — it is still in the form below.</p>
</div>

{
  /* **Sold out, and this is the case where losing somebody's typing hurts most.** They have
  filled in fourteen fields and are being told the race went while they were doing it. The
  form below still holds every value, so asking about a waiting list costs them nothing more.

  A white card in the established pattern rather than a horror flourish. Somebody has just
  had bad news; the campaign's atmosphere belongs on the poster, not on this. There is no
  waiting list to join yet, so this does not offer one — it gives the address that already
  exists and says plainly that nothing was taken. */
}
<div
  class="notice notice-bad nn-card"
  data-entry-soldout
  hidden
  tabindex="-1"
  role="alert"
>
  <p><strong>The race is full.</strong></p>
  <p>
    The last place went while this form was open. <strong
      >Nothing has been charged and no entry has been taken.</strong
    >
  </p>
  <p>
    Everything you typed is still in the form below. If you would like to be told about a
    place if one comes back, email <a href={`mailto:${race.contact}`}>{race.contact}</a>.
  </p>
</div>

{
  /* Something went wrong on the club's side after the form was accepted: the database could
  not be reached, or the payment page could not be created. **The one thing somebody needs to
  know is that no money moved**, and it is the first thing this says. */
}
<div
  class="notice notice-bad nn-card"
  data-entry-failed
  hidden
  tabindex="-1"
  role="alert"
>
  <p><strong>Sorry — your entry could not be completed just now.</strong></p>
  <p>
    <strong>Nothing has been charged</strong> and your entry is not finished. This is a problem
    at the club's end rather than anything you typed.
  </p>
  <p>
    Everything is still in the form below — please press the button again in a moment.
  </p>
</div>

{
  /* **A payment page cannot take a payment of nothing**, and this is what says so when one is
  somehow asked for. Stripe refuses a zero-total Checkout session outright.

  **It stopped being about guides with ADR-022** — a guide rides on the runner's entry now and
  never reaches a fee of their own — so nothing a person can select on this page leads here any
  more. It is a **backstop**, and it is kept for exactly that: a £0 fee reachable only by
  crafting a request, and a discount code that zeroes a fee that is not itself free. A place
  the club gives away goes through `/admin/nn/` instead, which is ADR-021.

  Deliberately not deleted along with the card. The reachable path is gone; the refusal is what
  makes the unreachable one safe. */
}
<div class="notice notice-bad nn-card" data-entry-free hidden tabindex="-1" role="alert">
  <p><strong>That entry cannot be completed online.</strong></p>
  <p>
    It came to nothing to pay, and the payment step has nothing to take.
    <strong>Nothing has been charged and no place has been taken.</strong>
  </p>
  <p>
    Email <a href={`mailto:${race.contact}`}>{race.contact}</a> and the race organisers will
    sort it out with you directly.
  </p>
</div>

{
  /* **The one notice on this form that a person is meant to meet.** Everything else here is
  the club losing a race against a sold-out field, or a defect. This is somebody who already
  has a place filling the form in again — and the most likely reason they are doing it is that
  they are not sure the first one worked, because there is no confirmation email yet (#73) and
  the return page deliberately never says "nothing was charged".

  So it says the two things that person needs, in this order: **no second charge, no second
  place.** Then where their entry actually is. The refusal is the database's, keyed on name
  and date of birth — see `entries.create_pending_purchase()` — so the last paragraph has to
  admit the case where two real runners share both. */
}
<div
  class="notice notice-bad nn-card"
  data-entry-already
  hidden
  tabindex="-1"
  role="alert"
>
  <p><strong>This runner already has a place in this race.</strong></p>
  <p>
    The club has an entry recorded against this name and date of birth.{' '}
    <strong>Nothing has been charged and no second place has been taken.</strong> One entry
    per runner.
  </p>
  <p>
    If you have an account with the club, your entry is on{' '}
    <a href="/account/entries/">your entries page</a>. If this is not you — two runners
    can share a name and a birthday — email{' '}
    <a href={`mailto:${race.contact}`}>{race.contact}</a> and the race organisers will sort
    it out.
  </p>
</div>

{
  /* **The only notice here that is not bad news**, which is why it is a plain card rather
  than a `notice-bad` one and why the Worker answers it 200.

  A discount code is a claim about money that this page cannot check: whether it is real,
  whether it has been withdrawn, whether its places are gone and whether it is even for the
  entry type chosen are four questions only the database can answer, and it answers all four
  as one refusal. So a submission carrying a code is **priced first and nothing is held** —
  `create_pending_purchase(p_preview => true)` runs every rule and returns before the first
  write — and this is where the answer is shown.

  **The four figures are painted by the Worker from that answer**, never computed here. A
  saving worked out in markup from a price the markup assumed is how the number on the page
  and the number on the card start disagreeing.

  Pressing "Continue" posts the whole form again with `discountConfirmed` set, which is what
  ends the step. Nothing is trusted from that field — the worst it can do is skip this
  screen, and the price is still the database's on both passes. */
}
<div class="notice nn-card" data-entry-confirm hidden tabindex="-1" role="status">
  <p><strong>Your discount code has been applied.</strong></p>
  {
    /* **A `<div>` around each pair, which is valid inside a `<dl>` and is what makes a pair a
    flex row at all.** The same arrangement the race-day schedule uses, and for the reason
    recorded there: a `<dl>` of loose `<dt>`/`<dd>` siblings cannot do this without a
    subgrid. Axe allows the wrapper. */
  }
  <dl class="nn-confirm-total">
    <div class="nn-confirm-row">
      <dt>Entry type</dt>
      <dd data-entry-confirm-fee></dd>
    </div>
    <div class="nn-confirm-row">
      <dt>Standard price</dt>
      <dd data-entry-confirm-list></dd>
    </div>
    <div class="nn-confirm-row">
      <dt>Your code takes off</dt>
      <dd data-entry-confirm-saving></dd>
    </div>
    <div class="nn-confirm-row">
      <dt>Total to pay</dt>
      <dd><strong data-entry-confirm-total></strong></dd>
    </div>
  </dl>
  <p>
    <strong>Nothing has been charged and no place has been held yet.</strong> Check the total,
    then continue to the payment page. If it is not what you expected, change your entry type
    or clear the code in the form below.
  </p>
  {
    /* **`form` rather than nesting**, because this notice sits with the other outcome
    notices above the form and the form's own submit button is at the foot of seven
    fieldsets. Somebody shown a total should not have to scroll past every field they have
    already filled in to accept it. */
  }
  <button class="button" type="submit" form="nn-entry-form">Continue to payment</button>
</div>

{
  /* Entries closing between this page loading and the form being sent is a real sequence,
  not a hypothetical one: somebody opens the page at 6:59 and presses the button at 7:01 on
  the last day. The Worker checks the window again when the form arrives. */
}
<div
  class="notice notice-bad nn-card"
  data-entry-closed
  hidden
  tabindex="-1"
  role="alert"
>
  <p><strong>Entries are not open.</strong></p>
  <p>
    They may have closed while this page was open. Nothing has been stored and nothing has
    been charged.
  </p>
</div>

{
  /* **A guide learns the position before the fields, not after them** — issue #22, and step
  0.4 of `docs/delivery/runbooks/entries-open.md`.

  **What this said until ADR-022 was that guide places could not be booked here at all**, which
  was true: a guide had to enter separately on a £0 fee, and Stripe refuses a zero-total
  session, so the one person on this page who could not finish it was the one person told so
  last. That is no longer the arrangement — a guide is entered on the runner's own entry — so
  the notice now points at the box that does it rather than at an email address.

  It is not a `role="alert"` and it is not hidden: nothing has gone wrong, and a runner reading
  it has simply been told where to look before filling anything in. A plain `.notice` — no
  `-ok`, no `-bad` — because colour carries none of the meaning here.

  **The stop in `worker/nn-entry.ts` is untouched**, which step 0.4 requires: this is copy in
  front of a backstop, not a replacement for one. */
}
<div class="notice nn-card" data-entry-guide>
  <p>
    Runners who need a guide or support runner can bring one, and <strong
      >that person enters free</strong
    >. You do not need a second entry for them — say so under
    <strong>Running with a guide</strong> below and give their details there.
  </p>
</div>

<p class="signup-privacy">
  One entry per runner. The club uses what you enter here to run the race and for nothing
  else. <a href="/nn/privacy/">What the club does with this</a>, including how to have it
  removed.
</p>

{
  /* A real form, posting to a real address. No JavaScript is involved in submitting it,
  validating it, or rendering what comes back.

  **It posts to the page it is on**, which is the page for one running of the race —
  `/nn/2026/`. That address is the whole of what tells the Worker which event this entry is
  for; there is no hidden event field and there should not be one, because a slug in a body is
  a slug somebody can change and an entry landing against a different open running is a
  mistake nothing would catch.

  `Astro.url.pathname` rather than a literal, for the same reason `NnNav.astro` derives the
  current page from it: a prop or a constant is a second place to state where this form lives,
  and the failure it invites is silent. `trailingSlash: 'always'` is what makes it exactly one
  address. */
}
{
  /* `data-entry-event-date` and `data-entry-minimum-age` are written by the Worker from the
  event row. They are the only two rules the enhancement cannot read off the DOM, and
  neither is personal data — they are the same two facts the page already displays. */
}
<form
  class="signup nn-card nn-entry"
  id="nn-entry-form"
  method="post"
  action={Astro.url.pathname}
  data-entry-form
  data-entry-event-date=""
  data-entry-minimum-age=""
>
  {
    /* **Which of this page's two forms arrived.** The interest form is on this page too — one
    is shown at a time — so the address cannot tell them apart and the body does.

    **Not the entry window, which would nearly work.** The Worker could infer "open means
    entry"; then somebody who opened this page a minute before entries opened would have their
    name and email address read as an entry and be shown fourteen validation errors about
    fields they were never asked for. What was submitted is a fact about the submission.

    Stated on both forms, so neither is identified by the absence of something — a stale cached
    page with no field is read as the interest form, which is the harmless side. */
  }
  <input type="hidden" name="form" value="entry" />

  {
    /* **What ends the discount code's confirm step.** Ships empty, so a first submission
    posts `discountConfirmed=""` and is priced rather than charged; the Worker writes `yes`
    into it when it renders the confirm notice, so the *second* submission skips the preview
    and holds the place.

    **Presence is not the test — the value is.** An empty hidden input still posts its name,
    so `form.get(...) !== null` would read every first submission as already confirmed and
    the step would never happen at all.

    Nothing is trusted from this field. The worst somebody can do by posting `yes` themselves
    is skip a confirmation screen they were being shown for their own benefit; the price is
    still `entries.fees`' on both passes and the code is still checked on both. */
  }
  <input type="hidden" name="discountConfirmed" value="" data-entry-confirmed />

  <!-- 1 — Your details ------------------------------------------------------------- -->
  <fieldset class="nn-fieldset">
    <legend class="nn-legend">Your details</legend>

    <div class="field">
      <label class="field-label" for="entry-first-name">First name</label>
      <p
        class="field-error"
        id="entry-first-name-error"
        data-entry-error="firstName"
        hidden
      >
      </p>
      <input
        class="field-input"
        id="entry-first-name"
        name="firstName"
        type="text"
        maxlength="60"
        autocomplete="given-name"
        required
        aria-describedby="entry-first-name-error"
        data-entry-value="firstName"
      />
    </div>

    <div class="field">
      <label class="field-label" for="entry-last-name">Last name</label>
      <p
        class="field-error"
        id="entry-last-name-error"
        data-entry-error="lastName"
        hidden
      >
      </p>
      <input
        class="field-input"
        id="entry-last-name"
        name="lastName"
        type="text"
        maxlength="60"
        autocomplete="family-name"
        required
        aria-describedby="entry-last-name-error"
        data-entry-value="lastName"
      />
    </div>

    <div class="field">
      <label class="field-label" for="entry-email">Email address</label>
      <p class="field-hint" id="entry-email-hint">Your entry confirmation goes here.</p>
      <p class="field-error" id="entry-email-error" data-entry-error="email" hidden></p>
      <input
        class="field-input"
        id="entry-email"
        name="email"
        type="email"
        maxlength="254"
        autocomplete="email"
        spellcheck="false"
        required
        aria-describedby="entry-email-hint entry-email-error"
        data-entry-value="email"
      />
    </div>

    <div class="field">
      <label class="field-label" for="entry-email-confirm"
        >Confirm your email address</label
      >
      <p class="field-hint" id="entry-email-confirm-hint">
        Typed again, because a confirmation sent to a mistyped address is one nobody finds
        out about.
      </p>
      <p
        class="field-error"
        id="entry-email-confirm-error"
        data-entry-error="emailConfirm"
        hidden
      >
      </p>
      {
        /* `autocomplete="off"` on purpose. A browser filling both boxes from the same saved
        address defeats the check entirely — the second box exists to be typed. */
      }
      <input
        class="field-input"
        id="entry-email-confirm"
        name="emailConfirm"
        type="email"
        maxlength="254"
        autocomplete="off"
        spellcheck="false"
        required
        aria-describedby="entry-email-confirm-hint entry-email-confirm-error"
        data-entry-value="emailConfirm"
      />
    </div>

    {
      /* **The runner's own number, and it belongs here rather than beside the emergency
      contact's.** Two phone boxes on one page are the likeliest pair on this form to be
      filled in the wrong way round, and the cheapest defence is distance: this one is with
      the other two ways of reaching *you*, and the other is four fieldsets down under a
      legend that says whose it is.

      **The hint names what the club will use it for and the fieldset it is not in.** ADR-025
      is a decision about a purpose — a start-time change, a course change, somebody missing
      from registration — and a required field with no stated purpose is the one people put
      a made-up number into.

      `autocomplete="tel"` because this genuinely is the person's own number, unlike both of
      the emergency boxes, which carry `autocomplete="off"` for the opposite reason. */
    }
    <div class="field">
      <label class="field-label" for="entry-phone">Phone number</label>
      <p class="field-hint" id="entry-phone-hint">
        Your own number. The club uses it to tell you about a change to the race — not on
        race day for an emergency, which is the contact further down.
      </p>
      <p class="field-error" id="entry-phone-error" data-entry-error="phone" hidden></p>
      <input
        class="field-input"
        id="entry-phone"
        name="phone"
        type="tel"
        maxlength="40"
        autocomplete="tel"
        required
        aria-describedby="entry-phone-hint entry-phone-error"
        data-entry-value="phone"
      />
    </div>
  </fieldset>

  <!-- 2 — About you --------------------------------------------------------------- -->
  <fieldset class="nn-fieldset">
    <legend class="nn-legend">About you</legend>

    {
      /* **Three number boxes, not a date picker.** A picker opens on this month and asks
      somebody to page back forty years, one month at a time, on a phone. Three boxes are
      typed in three seconds.

      A nested `<fieldset>` because the three inputs are one question: a screen reader
      announces "Date of birth, Day" rather than an unexplained "Day", and the error belongs
      to the group rather than to whichever box happens to be wrong.

      `inputmode="numeric"` brings up the number pad without `type="number"`, which on a
      birth year would add a spinner nobody wants and would silently accept `1e6`. */
    }
    <fieldset class="field nn-dob">
      <legend class="field-label">Date of birth</legend>
      <p class="field-hint" id="entry-dob-hint">
        For example, 9 12 1986. The club uses this to work out your age category.
      </p>
      <p class="field-error" id="entry-dob-error" data-entry-error="dateOfBirth" hidden>
      </p>

      <div class="nn-dob-parts">
        <span class="nn-dob-part">
          <label class="field-label" for="entry-dob-day">Day</label>
          <input
            class="field-input"
            id="entry-dob-day"
            name="dobDay"
            type="text"
            inputmode="numeric"
            maxlength="2"
            autocomplete="bday-day"
            required
            aria-describedby="entry-dob-hint entry-dob-error"
            data-entry-value="dobDay"
          />
        </span>
        <span class="nn-dob-part">
          <label class="field-label" for="entry-dob-month">Month</label>
          <input
            class="field-input"
            id="entry-dob-month"
            name="dobMonth"
            type="text"
            inputmode="numeric"
            maxlength="2"
            autocomplete="bday-month"
            required
            aria-describedby="entry-dob-hint entry-dob-error"
            data-entry-value="dobMonth"
          />
        </span>
        <span class="nn-dob-part nn-dob-year">
          <label class="field-label" for="entry-dob-year">Year</label>
          <input
            class="field-input"
            id="entry-dob-year"
            name="dobYear"
            type="text"
            inputmode="numeric"
            maxlength="4"
            autocomplete="bday-year"
            required
            aria-describedby="entry-dob-hint entry-dob-error"
            data-entry-value="dobYear"
          />
        </span>
      </div>
    </fieldset>

    {
      /* **Two questions, and the split is the point — see ADR-020.** This one is the race
      category: the closed list the club awards prizes in and publishes results by, which is
      three because three is how many categories there are. "Gender" on its own over these
      three options made a dropdown into a claim about how many genders exist, and the
      question underneath is where that is actually asked. */
    }
    <div class="field">
      <label class="field-label" for="entry-gender">Race category</label>
      <p class="field-hint" id="entry-gender-hint">
        Results and prizes are grouped into these categories, and this is used with your
        date of birth to work out your age category.
      </p>
      <p class="field-error" id="entry-gender-error" data-entry-error="gender" hidden></p>
