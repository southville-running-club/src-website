  {
    /* The running total is a **progressive enhancement and nothing more**: with scripting
    off each entry type carries its own price on its own card, which is the whole of what
    somebody needs to know before pressing the button. A total that could go stale is worse
    than no total. */
  }
  <p class="nn-total" data-entry-total hidden></p>

  {
    /* "Continue to payment", not "Submit". Somebody has to know a payment step follows
    before they press it rather than after. */
  }
  <button class="button" type="submit">Continue to payment</button>

  {
    /* **The line under the button now describes what actually happens.** Payment is
    connected: pressing this holds a place for half an hour and hands over to Stripe's own
    payment page. Saying so before the press is the whole reason the button says "Continue to
    payment" rather than "Submit" — and saying that the club never sees a card number is
    worth a line, because it is true and because it is the thing somebody is deciding about.

    If no payment key is configured the form still validates and stops, and the notice above
    says so. This line is not the place to hedge about that: it would be a permanent
    disclaimer about a temporary state, on the page's one call to action.

    **"30 minutes" against a hold of 31 is deliberate rounding in the safe direction.** The
    extra minute exists because Stripe will not accept a session expiry less than thirty
    minutes ahead of its own clock; quoting the real figure would be promising a number to
    the minute, and quoting 35 would be promising more than the row delivers. */
  }
  <p class="field-hint nn-paynote">
    Payment is taken by Stripe on their own secure page. The club never sees your card
    details. Your place is held for 30 minutes while you pay.
  </p>

  {
    /* **The permit number, because ARC ask for it on the entry form.** Printed on the permit
    itself: "Please quote Permit Number on race entry forms and advertising material." The
    year page's facts list is the advertising half; this is the form half, and the race page
    alone would not satisfy it.

    **From `race.json`, never typed here.** It is a fact about one running, so it lives where
    the date and the field size live — and a number retyped into markup is a number that
    outlives the year it belongs to.

    **At the foot, after the pay note, rather than under the heading.** ARC ask for the
    number to be quoted, not made prominent, and the printed-form convention of putting it at
    the top exists because paper detaches from its context. A web form does not: this page is
    headed with the race and the year already.

    The register matches `/nn/privacy/`'s "Our race is run under an ARC permit", which is the
    only other place on the site that mentions the permit at all. */
  }
  <p class="field-hint nn-permit">
    This race is run under ARC permit {race.permit}.
  </p>
</form>

<script>
  /**
   * The enhancement, and **every line of it is optional**.
   *
   * Three things happen here and not one of them is load-bearing:
   *
   *   1. the age category appears as the date of birth and gender are typed;
   *   2. the guide's fields appear once somebody says a guide is running with them;
   *   3. a message appears beside a field when leaving it, and a running total appears.
   *
   * With scripting off: the category is worked out by the server and shown on the outcome,
   * the guide's fields are simply visible and the server decides whether they had to be
   * filled in, and every price is on its own card. **Nothing is unreachable and nothing is
   * unfinishable.** That is the requirement, and it is why this file may be deleted without
   * the form stopping working.
   *
   * ## It validates with the schema, not with a copy of it
   *
   * `parseNnEntry` is the same function the Worker runs. A second set of rules written in
   * the browser is a second set of rules to keep in step, and the one that drifts is always
   * the one nobody is testing. The cost is Zod in the page bundle, which is paid knowingly
   * — see `apps/main/README.md` for the measured figure.
   *
   * **It never blocks a submission.** No `preventDefault`, no "fix this before continuing":
   * the browser submits and the Worker decides, exactly as it does with scripting off. This
   * is a convenience and the server is the control, so the two can never disagree about
   * whether something was accepted.
   */
  import {
    parseNnEntry,
    type NnEntryField,
    type NnEntryRules,
  } from '@src/shared/nn-entry';
  import { deriveAgeCategory, parseIsoDate, type Gender } from '@src/shared/age-category';

  const form = document.querySelector<HTMLFormElement>('[data-entry-form]');

  // The entry form is only in the page when entries are open, so the ordinary case on a
  // closed day is this script doing nothing at all.
  if (form) {
    enhance(form);
  }

  function enhance(entryForm: HTMLFormElement): void {
    const eventDate = parseIsoDate(entryForm.dataset.entryEventDate ?? '');

    // No usable event date means the two derivations that depend on it cannot be trusted,
    // so they are simply not offered. The form still submits and the server still validates.
    if (eventDate === null) {
      return;
    }

    const minimumAgeRaw = entryForm.dataset.entryMinimumAge ?? '';
    const rules: NnEntryRules = {
      eventDate,
      minimumAge: minimumAgeRaw === '' ? null : Number(minimumAgeRaw),
      feeCodes: offeredFeeCodes(entryForm),
    };

    const shown = new Set<NnEntryField>();

    // A field already carrying a server message keeps it, and stays in the set so it is
    // cleared the moment it is put right rather than at the next round trip.
    for (const element of entryForm.querySelectorAll<HTMLElement>('[data-entry-error]')) {
      if (!element.hidden) {
        shown.add(element.dataset.entryError as NnEntryField);
      }
    }

    updateCategory(entryForm, rules);
    updateGuideVisibility(entryForm);
    updateTotal(entryForm);

    entryForm.addEventListener('change', () => {
      updateCategory(entryForm, rules);
      updateGuideVisibility(entryForm);
      updateTotal(entryForm);
      revalidate(entryForm, rules, shown);
    });

    entryForm.addEventListener('input', () => {
      updateCategory(entryForm, rules);
      // Only fields that are *already* complaining are re-checked while typing. Telling
      // somebody their email address is invalid after two characters is not help.
      revalidate(entryForm, rules, shown);
    });

    // `focusout` rather than `blur`, because `blur` does not bubble.
    entryForm.addEventListener('focusout', (event) => {
      const field = fieldOf(event.target);
      if (field !== null) {
        shown.add(field);
        revalidate(entryForm, rules, shown);
      }
    });
  }

  /** Which fee codes the Worker actually revealed — the rest are not on offer. */
  function offeredFeeCodes(entryForm: HTMLFormElement): string[] {
    return [...entryForm.querySelectorAll<HTMLElement>('[data-entry-fee]')]
      .filter((card) => !card.hidden)
      .map((card) => card.dataset.entryFee ?? '');
  }

  function values(entryForm: HTMLFormElement): Record<string, unknown> {
    return Object.fromEntries(new FormData(entryForm));
  }

  /**
   * The containers a message can belong to. Named once and used twice below, deliberately:
   * "which container is this control in" and "which container does this message belong to"
   * have to be the same question, or the second can answer with a message that is not the
   * first's — which is exactly what went wrong.
   */
  const FIELD_CONTAINER = '.field, .nn-dob, .nn-fee';

  /**
   * The error element's own `data-entry-error`, for the control that was just left.
   *
   * **A message inside a *nested* container belongs to that container, not to this one.**
   * There is no nested pair on the page today — the one there was is the England Athletics
   * box, which the club stopped asking for on 29 August 2026 — and the rule is kept because
   * the next conditional field will re-create the shape. The box was a `.field` inside the
   * affiliated `.nn-fee` card. A plain descendant search from the affiliated *radio* found
   * `eaNumber`, and read "they have finished with the entry type" as "they have finished with
   * the England Athletics number". Two things followed, and the second is the expensive one:
   *
   *   1. the box complained about a number nobody had been asked for yet — the precise
   *      behaviour "says nothing about fields nobody has touched yet" exists to forbid; and
   *   2. the message appeared *between the press and the release of the very click that
   *      caused it*. It is 67px tall at 320px and it sits above the other two cards, so it
   *      pushed them 72px down out from under the pointer, the release landed somewhere else,
   *      no `click` ever reached the radio, and **the entry type could not be changed at
   *      all**. Reproduced in both engines at 320px: every press across the full height of
   *      the VI guide radio left the affiliated entry selected and the total at £15.00.
   *
   * Nothing is lost by the narrower search. `feeCode`'s own message lives at the fieldset
   * level, outside every `.nn-fee`, so leaving a fee radio never reached it before this
   * change either — the only field it could ever mark was the wrong one.
   */
  function fieldOf(target: EventTarget | null): NnEntryField | null {
    if (!(target instanceof HTMLElement)) {
      return null;
    }

    const container = target.closest(FIELD_CONTAINER);
    const error = [
      ...(container?.querySelectorAll<HTMLElement>('[data-entry-error]') ?? []),
    ].find((candidate) => candidate.closest(FIELD_CONTAINER) === container);

    return (error?.dataset.entryError as NnEntryField | undefined) ?? null;
  }

  /**
   * Show or clear a message for each field somebody has already finished with.
   *
   * **Nothing is ever shown for a field that has not been touched.** Walking down a form
   * lighting up every box ahead of the person is the version of this that makes a long form
   * feel hostile.
   */
  function revalidate(
    entryForm: HTMLFormElement,
    rules: NnEntryRules,
    shown: Set<NnEntryField>,
  ): void {
    const result = parseNnEntry(values(entryForm), rules);
    const errors = result.ok ? {} : result.errors;

    for (const field of shown) {
      const message = errors[field];
      const element = entryForm.querySelector<HTMLElement>(
        `[data-entry-error="${field}"]`,
      );

      if (!element) {
        continue;
      }

      // `textContent`, never `innerHTML`. The messages are the schema's own and hold no
      // markup, and there is deliberately no assignment here that could carry any.
      element.textContent = message ?? '';
      element.hidden = message === undefined;

      for (const control of entryForm.querySelectorAll<HTMLElement>(
        `[aria-describedby~="${element.id}"]`,
      )) {
        if (message === undefined) {
          control.removeAttribute('aria-invalid');
        } else {
          control.setAttribute('aria-invalid', 'true');
        }
      }
    }
  }

  /** The live age category, announced politely. */
  function updateCategory(entryForm: HTMLFormElement, rules: NnEntryRules): void {
    const target = entryForm.querySelector<HTMLElement>('[data-entry-category]');
    if (!target) {
      return;
    }

    const read = (name: string) => String(new FormData(entryForm).get(name) ?? '').trim();
    const day = read('dobDay');
    const month = read('dobMonth');
    const year = read('dobYear');
    const gender = read('gender');

    const dateOfBirth = parseIsoDate(
      `${year.padStart(4, '0')}-${month.padStart(2, '0')}-${day.padStart(2, '0')}`,
    );

    if (dateOfBirth === null || gender === '') {
      target.textContent = '';
      target.hidden = true;
      return;
    }

    const category = deriveAgeCategory(dateOfBirth, gender as Gender, rules.eventDate);

    // Each wording is a statement of fact. Where the club has not decided something, that is
    // what it says — a category is never invented to fill the gap.
    const text = category.known
      ? `Age on race day: ${category.age}. You will run as ${category.label}.`
      : category.reason === 'gender-has-no-categories'
        ? `Age on race day: ${category.age}. The club has not confirmed age categories for non-binary runners.`
        : `Age on race day: ${category.age}. The club's youngest age category starts at 18.`;

    target.textContent = text;
    target.hidden = false;
  }

  /**
   * Show the guide's fields once somebody says a guide is running with them.
   *
   * **The arrangement the England Athletics box ended up in, and for the same two reasons.**
   * The Worker validates them conditionally whatever the browser did, so somebody without this
   * script sees the fields, leaves them empty, and is never asked about them — and the
   * wrappers sit *after* the checkbox rather than around it, so revealing them moves only
   * what is below and never the control that was just pressed.
   *
   * `querySelectorAll`, because there are two wrappers: the guide's own fields, and their
   * medical notes down in the medical section under the one consent that covers both.
   */
  function updateGuideVisibility(entryForm: HTMLFormElement): void {
    const declared = entryForm.querySelector<HTMLInputElement>(
      '[data-entry-checked="viGuide"]',
    );

    if (!declared) {
      return;
    }

    for (const block of entryForm.querySelectorAll<HTMLElement>(
      '[data-entry-guide-fields]',
    )) {
      block.hidden = !declared.checked;
    }
  }

  /** The running total. Pence, so a percentage discount cannot introduce a rounding bug. */
  function updateTotal(entryForm: HTMLFormElement): void {
    const target = entryForm.querySelector<HTMLElement>('[data-entry-total]');
    const chosen = entryForm.querySelector<HTMLInputElement>('.nn-fee-radio:checked');
    const card = chosen?.closest<HTMLElement>('[data-entry-fee]');
    const pence = Number(card?.dataset.entryFeePence ?? '');

    if (!target || !card || !Number.isInteger(pence)) {
      if (target) {
        target.hidden = true;
      }
      return;
    }

    const money =
      pence === 0
        ? 'Free'
        : `£${Math.floor(pence / 100)}.${String(pence % 100).padStart(2, '0')}`;

    target.textContent = `Total to pay: ${money}`;
    target.hidden = false;
  }
</script>
