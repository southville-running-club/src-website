{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "src-main",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-08",

  // `@supabase/supabase-js` reaches for a small number of Node built-ins. Without this
  // the Worker builds and then fails at runtime, which is the worst place to find out.
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",

    // The Worker runs before static assets are matched, which is what lets it fill in
    // the health timestamp on every HTML response via HTMLRewriter — without this, a
    // request would be served straight from `dist/` and never reach the handler that
    // does the rewrite. It is also what lets it forward `/timing/*` locally, standing in
    // for the Cloudflare route that does the same thing in production. It costs one
    // Worker invocation per request against a 100,000/day free allowance.
    "run_worker_first": true,
  },

  // ---------------------------------------------------------------------------------
  // Top level is **local development**. No routes, and a localhost database.
  // ---------------------------------------------------------------------------------
  // Deliberately the safe default. A plain `wrangler deploy` — the command somebody runs
  // by accident — publishes a Worker with no hostname and a database it cannot reach.
  // That is loud and harmless. The inverse arrangement would put localhost config on the
  // live race domain, which is neither.
  //
  // Both values are safe to expose by design: row-level security is what enforces access,
  // not the key. They are the fixed ones every `supabase start` prints.
  "vars": {
    "PUBLIC_SUPABASE_URL": "http://127.0.0.1:54321",
    "PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH",

    // **Local only, and its absence in production is load-bearing.** Cloudflare dispatches
    // `/timing/*` to the timing Worker at the edge, so in production those requests never
    // reach this Worker. On a laptop there is no edge, so this Worker forwards them
    // itself — which is what lets one port serve the whole site locally.
    "TIMING_ORIGIN": "http://localhost:8788",

    // **Cloudflare's own published testing key, not a real site key.** `1x00000000000000000000AA`
    // always passes, on any domain including `localhost` — documented at
    // developers.cloudflare.com/turnstile/troubleshooting/testing. Paired with the equally
    // public dummy secret key on the GoTrue side locally and in CI (`ci.yml`'s "Start the
    // local Supabase stack" step), so nobody needs the club's real Turnstile secret just to
    // run the test suite. Production's real site key is in `env.production` below.
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
  },

  // ---------------------------------------------------------------------------------
  // Stripe is **not here**, in either block, and that is the point
  // ---------------------------------------------------------------------------------
  // `STRIPE_SECRET_KEY` is a Worker secret — `wrangler secret put`, recorded as a manual
  // step in apps/main/README.md. It never appears in this file, in a `vars` block, or
  // anywhere else in this repository. `STRIPE_API_BASE` exists only so the local site and
  // the acceptance suite can run end to end against `scripts/stripe-stub.mjs` without a
  // Stripe account, and it is passed on the `wrangler dev` command line in
  // apps/main/package.json — there is no path from a dev-server flag to a deployed Worker.
  //
  // `tests/unit/worker-config.test.ts` asserts that neither block mentions Stripe at all,
  // so the day somebody pastes a key in here to "just try it", CI says no.

  // ---------------------------------------------------------------------------------
  // The Cron Trigger — housekeeping, and emphatically not the capacity mechanism
  // ---------------------------------------------------------------------------------
  // Every five minutes, `scheduled()` moves lapsed holds to `expired`. **Capacity does not
  // depend on it having run**: `entries.create_pending_purchase()` counts a pending hold
  // only while `hold_expires_at` is in the future, so an abandoned place is back in the pool
  // the instant it lapses. This stops an abandoned purchase reading as `pending` forever.
  //
  // Declared in both blocks because Wrangler does not inherit `triggers` into an
  // environment, and a cron that only exists locally would be a cron nobody notices is
  // missing. Free plan: Cron Triggers are included, and one every five minutes is 288
  // invocations a day against a 100,000/day allowance.
  "triggers": {
    "crons": ["*/5 * * * *"],
  },

  "observability": {
    "enabled": true,
  },

  // ---------------------------------------------------------------------------------
  // `--env production` is what actually deploys. Worker name: `src-main-production`.
  // ---------------------------------------------------------------------------------
  // Wrangler appends the environment to the name and will not let it be overridden, so
  // the suffix is a fact rather than a choice.
  //
  // **`vars` are not inherited from the top level.** Cloudflare's own rule — they must be
  // repeated per environment. That is why the production database appears here in full.
  "env": {
    "production": {
      // **One hostname for everything the club owns**, told apart by path:
      //
      //   /         the website        this Worker
      //   /nn       Nightingale Nightmare  this Worker
      //   /timing   race timing        apps/timing, via a more specific route
      //
      // At the Squarespace cutover the hostname changes and nothing else does. That is
      // the point: the new site can be built up around NN and timing without either of
      // them moving.
      //
      // **The hostname is code.** Cloudflare creates the DNS record and issues the
      // certificate from this entry; nothing is added by hand at the registrar or in the
      // dashboard. It is proxied, which is correct: Cloudflare is the origin. Mail
      // hostnames are never proxied, and nothing here touches one.
      "routes": [
        {
          "pattern": "new.southvillerunningclub.co.uk",
          "custom_domain": true,
        },
      ],

      // **This must stay byte-identical to apps/timing's production block.** One database
      // behind both front doors is what makes a results archive derived from timing data
      // possible at all, and two projects cannot join. Asserted by
      // `tests/unit/supabase-config.test.ts` so it cannot drift unnoticed.
      "vars": {
        "PUBLIC_SUPABASE_URL": "https://ketipxpyjjglwpqazsft.supabase.co",
        "PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_reN3BxHbZfvKF75bee6n3w_8hfq1FXg",

        // The club's real Turnstile site key. Public by design — it is what the widget
        // script reads client-side — and its secret pair lives only as the
        // `SUPABASE_AUTH_CAPTCHA_SECRET` GitHub Actions repository secret, read by GoTrue.
        "TURNSTILE_SITE_KEY": "0x4AAAAAAEaeMm9jDSJB7Gqy",
      },

      // Repeated rather than inherited — see the note at the top level. Wrangler does not
      // carry `triggers` into an environment.
      "triggers": {
        "crons": ["*/5 * * * *"],
      },

      "observability": {
        "enabled": true,
      },
    },
  },
}
