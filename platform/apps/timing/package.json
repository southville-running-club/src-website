{
  "name": "@src/timing",
  "version": "0.0.0",
  "private": true,
  "description": "The race-timing platform on Cloudflare — hello-world ahead of the port",
  "scripts": {
    "dev": "next dev --port 8788",
    "build": "NODE_ENV=production next build",
    "preview": "opennextjs-cloudflare preview --port 8788",
    "deploy": "NODE_ENV=production opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "typecheck": "tsc --noEmit",
    "build:worker": "NODE_ENV=production opennextjs-cloudflare build",
    "build:next": "NODE_ENV=production next build"
  },
  "dependencies": {
    "@src/db": "*",
    "@src/shared": "*",
    "@supabase/supabase-js": "^2.112.2",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "wrangler": "^4.120.0"
  }
}
