{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "src-timing",

  // ⚠️ **`worker-entry.js`, not `.open-next/worker.js`, and the difference is the whole of how a
  // Durable Object gets into an OpenNext application.** A DO class has to be exported from the
  // Worker's entry module, and `.open-next/worker.js` is generated from a template inside the
  // package on every build — not ours to edit, and `.gitignore`d. `worker-entry.js` re-exports
  // everything OpenNext's entry does, adds `LeaderboardRoom`, and hands every request that is
  // not the leaderboard socket straight to OpenNext. Its own header carries the full argument,
  // including why it is plain JavaScript. See #204.
  "main": "worker-entry.js",

  "compatibility_date": "2026-08-08",

  // Both are required by OpenNext rather than chosen: `nodejs_compat` for Next.js's own
  // Node API use, and `global_fetch_strictly_public` so a `fetch()` to the Worker's own
  // hostname goes out to the internet and back rather than short-circuiting internally.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },

  // OpenNext needs to be able to call itself — this is its own binding, not a second
  // Worker. The name must match the Worker's own `name` above.
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "src-timing",
    },
  ],

  // ---------------------------------------------------------------------------------
  // The live leaderboard's rooms — one Durable Object per race. #204, ADR-034.
  // ---------------------------------------------------------------------------------
  // Hibernatable WebSockets, holding no race data: the room broadcasts *"something about
  // this race changed"* and every connected screen re-reads `timing.leaderboard()` over
  // the ordinary permissioned HTTP path. `durable-objects/leaderboard-room.ts` carries
  // the argument, and it is what keeps the slice cuttable — ADR-034 says falling back to
  // Supabase Realtime must stay possible, and the derivation lives in
  // `packages/shared/src/timing/leaderboard.ts` where no transport can reach it.
  //
  // ⚠️ **Repeated under `env.production` below rather than inherited.** Wrangler inherits
  // `main` and `compatibility_date` into an environment and does **not** inherit bindings —
  // which is why `services` and `vars` are already written twice in this file. A
  // `durable_objects` block here and not there is a production Worker with no binding, and
  // the failure is a leaderboard that silently never refreshes rather than an error.
  "durable_objects": {
    "bindings": [
      {
        "name": "LEADERBOARD",
        "class_name": "LeaderboardRoom",
      },
    ],
  },

  // ⚠️ **`new_sqlite_classes`, not `new_classes`, and it is not a preference.** The Workers
  // free plan offers only the SQLite storage backend for a *new* Durable Object class; a
  // `new_classes` entry is refused at deploy with an error about the plan, which is a thing
  // to find out here rather than on a release. The class writes no storage at all — see its
  // header — so declaring the backend is not the same as using it.
  //
  // **Top level only.** Migrations are one of the keys Wrangler inherits into every
  // environment, and a copy under `env.production` would be a second declaration of the same
  // tag.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LeaderboardRoom"],
    },
  ],

  // ---------------------------------------------------------------------------------
  // Top level is **local development**. No routes, and a localhost database.
  // ---------------------------------------------------------------------------------
  // The safe default, exactly as in apps/main: a plain `wrangler deploy` publishes a
  // Worker with no hostname and an unreachable database, rather than putting localhost
  // config on a live domain.
  "vars": {
    "PUBLIC_SUPABASE_URL": "http://127.0.0.1:54321",
    "PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH",
  },

  "observability": {
    "enabled": true,
  },

  // ---------------------------------------------------------------------------------
  // `--env production` is what actually deploys. Worker name: `src-timing-production`.
  // ---------------------------------------------------------------------------------
  "env": {
    "production": {
      // **A path route, not a custom domain**, and the difference matters.
      //
      // `new.<apex>` belongs to apps/main as a Custom Domain. Cloudflare matches routes
      // most-specific-first, and a route carrying a path beats a Custom Domain on the
      // same hostname — so `/timing/*` is dispatched here at the edge and never reaches
      // apps/main at all.
      //
      // Because this is a route rather than a custom domain, **Cloudflare does not create
      // a DNS record for it.** It does not need to: apps/main's Custom Domain already
      // created the proxied `new` record, and this route attaches to that hostname.
      //
      // Next.js is configured with `basePath: '/timing'` to match, so the application's
      // own links and assets resolve under the same prefix.
      //
      // **A plain string, not `{ pattern: ... }`.** Wrangler's schema requires the object
      // form to carry one of `zone_id`, `zone_name` or `custom_domain` — a bare `pattern`
      // fails validation with "these weren't valid", which only surfaces on a real
      // `wrangler deploy`, never locally and never in CI (neither ever deploys for real).
      // The string form is the plain-route case exactly: no zone binding needed, because
      // it attaches to the zone `apps/main`'s Custom Domain already created.
      //
      // **Two routes, not one.** `/timing/*` only matches paths that already have a
      // trailing segment after `/timing/` — the bare `/timing` request (no trailing
      // slash) does not match it, falls through to apps/main's Custom Domain, and 404s
      // there. The exact-path route covers that case.
      "routes": [
        "new.southvillerunningclub.co.uk/timing",
        "new.southvillerunningclub.co.uk/timing/*",
      ],

      // OpenNext needs to call itself. **The service name must match the deployed Worker,
      // which carries the `-production` suffix** — pointing it at `src-timing` here would
      // bind to a Worker that does not exist.
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "src-timing-production",
        },
      ],

      // **The same rooms, declared again because Wrangler does not inherit a binding.** See
      // the block at the top level: omitting this is a production Worker whose leaderboard
      // never refreshes, with nothing failing to say so. No `script_name` — the class lives
      // in this Worker, which is what `worker-entry.js` exports it for.
      "durable_objects": {
        "bindings": [
          {
            "name": "LEADERBOARD",
            "class_name": "LeaderboardRoom",
          },
        ],
      },

      // **Byte-identical to apps/main's production block, and that is the point.** One
      // database behind both front doors. Asserted by
      // `../main/tests/unit/supabase-config.test.ts`.
      "vars": {
        "PUBLIC_SUPABASE_URL": "https://ketipxpyjjglwpqazsft.supabase.co",
        "PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_reN3BxHbZfvKF75bee6n3w_8hfq1FXg",
      },

      "observability": {
        "enabled": true,
      },
    },
  },
}
