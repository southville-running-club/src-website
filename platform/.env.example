# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Only two variables should ever be needed. If a build appears to want a third — in
# particular the Supabase service role key — the row-level security policy is wrong, and
# that is the thing to fix. See docs/architecture/principles.md.
#
# Local values come from `npm run db:start`, which prints them. They are the same on every
# machine, because the local Supabase stack uses fixed demo keys.

# Safe to expose. Appears in client code.
PUBLIC_SUPABASE_URL=

# Safe to expose. Appears in client code — row-level security is what enforces access.
PUBLIC_SUPABASE_ANON_KEY=
