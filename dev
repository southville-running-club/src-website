#!/usr/bin/env bash
#
# The one command for working on this platform locally.
#
# It exists because the npm project lives in `platform/` while the repository root is
# documentation, so `npm run …` at the root finds nothing. Rather than asking everybody to
# remember a `cd`, this script knows where things are and does the whole job: Docker, the
# database, the seed, the builds, both Workers, and tidying up afterwards.
#
#   ./dev up        bring the whole site up and open it
#   ./dev test      run the worker and acceptance tests, then stop everything
#                   --keep-up leaves the site running afterwards
#   ./dev check     lint, types, unit and database tests — no browsers, no builds
#   ./dev smoke     the seven live-site assertions, against localhost
#                   --live checks the deployed site at new.southvillerunningclub.co.uk
#                   instead — the same check smoke.yml runs after every push to main
#   ./dev reset     rebuild the database from migrations and re-seed
#   ./dev down      stop the Workers and the database
#   ./dev logs      tail the running Workers
#
# Everything is idempotent. Running `up` twice is fine; so is `down` when nothing is up.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLATFORM="$REPO_ROOT/platform"
RUN_DIR="$REPO_ROOT/.dev"

MAIN_PORT=8787
TIMING_PORT=8788
# A fake Stripe. This repository holds no Stripe credentials, so the local site talks to
# `platform/scripts/stripe-stub.mjs` instead and the entry form works end to end on a laptop
# — a real POST, a real held place, a real 303 to a checkout.stripe.com address that nobody
# follows. `apps/main`'s `preview` script points STRIPE_API_BASE at this port.
STRIPE_STUB_PORT=8789
SITE="http://localhost:$MAIN_PORT"

mkdir -p "$RUN_DIR"

# Set for the duration of start_workers — a Ctrl-C or a failure partway through leaves
# whichever Worker had already started running, disowned and otherwise unkillable except
# by hand, unless something is watching for exactly that window.
STARTING_WORKERS=0

# ---------------------------------------------------------------------------------------
# Output. Plain enough to read in a CI log, clear enough to read at speed.
# ---------------------------------------------------------------------------------------
if [ -t 1 ]; then
  BOLD=$'\033[1m'; DIM=$'\033[2m'; GREEN=$'\033[32m'; RED=$'\033[31m'; RESET=$'\033[0m'
else
  BOLD=''; DIM=''; GREEN=''; RED=''; RESET=''
fi

step() { printf '\n%s==>%s %s%s\n' "$BOLD" "$RESET" "$BOLD" "$1$RESET"; }
info() { printf '    %s%s%s\n' "$DIM" "$1" "$RESET"; }
ok()   { printf '    %s✓%s %s\n' "$GREEN" "$RESET" "$1"; }

die() {
  printf '\n%serror%s %s\n\n' "$RED" "$RESET" "$1" >&2
  [ "$STARTING_WORKERS" -eq 1 ] && stop_workers >/dev/null 2>&1
  exit 1
}

# A Ctrl-C mid-startup means "cancel this", not "leave whatever came up running" — the
# opposite of what `disown` is there for once startup has actually finished.
interrupted() {
  [ "$STARTING_WORKERS" -eq 1 ] && stop_workers >/dev/null 2>&1
  exit 130
}
trap interrupted INT TERM

# ---------------------------------------------------------------------------------------
# Prerequisites. `supabase`, `wrangler` and everything else this script calls are local
# devDependencies invoked bare from npm scripts — npm puts platform/node_modules/.bin on
# PATH for the duration of `npm run`, which only exists once `npm install` has been run
# there. `./dev` is meant to be the single touch point, so it runs that install itself
# rather than sending someone to a second command — but only node and npm themselves are
# left for a human, since there is no safe way to install a language runtime for them.
# ---------------------------------------------------------------------------------------
check_prerequisites() {
  step "Checking prerequisites"

  command -v node >/dev/null 2>&1 || die "node is not installed. It is required to run
    anything in platform/. Install it — nodejs.org, or a version manager such as nvm —
    matching the version in platform/.nvmrc."

  command -v npm >/dev/null 2>&1 || die "npm is not installed. It ships with node normally;
    if node is present but npm is not, reinstall node from nodejs.org or your version
    manager."

  # A stale install is treated the same as a missing one. Comparing package-lock.json
  # alone misses the case of a hand-edited package.json that nobody has run `npm install`
  # against yet — an every-workspace `add a dependency` is exactly that — so the stamp is
  # checked against every package.json in the workspace, not just the lockfile.
  local stamp="$PLATFORM/node_modules/.dev-install-stamp"
  local needs_install=0
  [ -d "$PLATFORM/node_modules" ] || needs_install=1
  [ -x "$PLATFORM/node_modules/.bin/supabase" ] || needs_install=1
  [ -f "$stamp" ] || needs_install=1
  if [ "$needs_install" -eq 0 ]; then
    [ "$PLATFORM/package-lock.json" -nt "$stamp" ] && needs_install=1
    find "$PLATFORM" -name package.json -not -path '*/node_modules/*' -newer "$stamp" \
      2>/dev/null | grep -q . && needs_install=1
  fi

  if [ "$needs_install" -eq 1 ]; then
    step "Installing dependencies"
    (cd "$PLATFORM" && npm install >"$RUN_DIR/install.log" 2>&1) \
      || { tail -30 "$RUN_DIR/install.log"; die "npm install failed — see $RUN_DIR/install.log"; }
    touch "$stamp"
    ok "dependencies installed"
  fi

  ok "node, npm and project dependencies are present"
}

# ---------------------------------------------------------------------------------------
# Docker, and waiting for it properly
# ---------------------------------------------------------------------------------------
ensure_docker() {
  if docker info >/dev/null 2>&1; then
    ok "Docker is running"
    return
  fi

  command -v docker >/dev/null 2>&1 || die "Docker is not installed. It is required: the
    local stack is a real Postgres, which is the only way row-level security can be
    tested rather than mocked."

  step "Starting Docker"
  case "$(uname -s)" in
    Darwin) open -a Docker 2>/dev/null || die "Could not start Docker Desktop. Start it by hand." ;;
    *)      die "Docker is not running. Start it, then try again." ;;
  esac

  info "waiting for the daemon (this takes a minute on a cold start)"
  local waited=0
  until docker info >/dev/null 2>&1; do
    sleep 2
    waited=$((waited + 2))
    [ "$waited" -lt 120 ] || die "Docker did not start within two minutes."
  done
  ok "Docker is running"
}

ensure_database() {
  # `supabase status` is the honest check — containers can exist but not be serving.
  if (cd "$PLATFORM/packages/db" && npx --no-install supabase status >/dev/null 2>&1); then
    ok "the database is up"
    return
  fi

  step "Starting the database"
  info "Postgres, auth, storage and Studio, in Docker"
  (cd "$PLATFORM" && npm run db:start >"$RUN_DIR/db.log" 2>&1) \
    || { tail -20 "$RUN_DIR/db.log"; die "the database did not start — see $RUN_DIR/db.log"; }
  ok "the database is up"
}

# `packages/db/tests` reads SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_DB_URL — the anon
# client checks what can be *reached*, the privileged DB_URL connection checks what is *in*
# a table, and testing an access boundary from one side only proves half of it. `ci.yml`
# exports the same three from `supabase status -o env`; this mirrors it so `./dev check`
# does not just advertise the database tests but actually runs them.
export_supabase_env() {
  local env_output
  env_output="$(cd "$PLATFORM/packages/db" && npx --no-install supabase status -o env)"
  export SUPABASE_URL SUPABASE_ANON_KEY SUPABASE_DB_URL
  SUPABASE_URL="$(printf '%s\n' "$env_output" | grep '^API_URL=' | cut -d= -f2- | tr -d '"')"
  SUPABASE_ANON_KEY="$(printf '%s\n' "$env_output" | grep '^ANON_KEY=' | cut -d= -f2- | tr -d '"')"
  SUPABASE_DB_URL="$(printf '%s\n' "$env_output" | grep '^DB_URL=' | cut -d= -f2- | tr -d '"')"
}

# ---------------------------------------------------------------------------------------
# Builds. Deliberately separate commands: `build` produces the Next.js output that OpenNext
# then bundles, and merging them makes OpenNext invoke itself. See apps/timing/README.md.
# ---------------------------------------------------------------------------------------
build_site() {
  step "Building"
  info "apps/main — static Astro"
  (cd "$PLATFORM" && npm run build >"$RUN_DIR/build.log" 2>&1) \
    || { tail -30 "$RUN_DIR/build.log"; die "the build failed — see $RUN_DIR/build.log"; }
  info "apps/timing — the OpenNext Worker bundle"
  (cd "$PLATFORM" && npm run build:worker >>"$RUN_DIR/build.log" 2>&1) \
    || { tail -30 "$RUN_DIR/build.log"; die "the Worker bundle failed — see $RUN_DIR/build.log"; }
  ok "both applications built"
}

# ---------------------------------------------------------------------------------------
# The Workers
# ---------------------------------------------------------------------------------------
port_is_serving() { curl -sf -o /dev/null --max-time 2 "$1" 2>/dev/null; }

wait_for() {
  local url="$1" name="$2" waited=0
  until port_is_serving "$url"; do
    sleep 1
    waited=$((waited + 1))
    [ "$waited" -lt 90 ] || die "$name did not come up within 90s."
  done
}

# Start a long-running server and **fully detach it**, so `./dev up` returns to the prompt.
#
# All three streams are redirected and stdin is closed: a child that still holds the
# terminal keeps the shell waiting for it, which is exactly what `up` must not do. `disown`
# then removes it from this shell's job table so no exit trap can reap it.
spawn() {
  local name="$1" dir="$2"; shift 2
  (
    cd "$dir" || exit 1
    nohup "$@" >"$RUN_DIR/$name.log" 2>&1 </dev/null &
    echo $! >"$RUN_DIR/$name.pid"
    disown
  )
}

start_workers() {
  step "Starting the site"

  if port_is_serving "$SITE/"; then
    ok "already running at $SITE"
    return
  fi

  STARTING_WORKERS=1

  # `apps/timing` first: `apps/main` forwards /timing to it, so starting the other way
  # round gives a window where the site is up and /timing 502s. Same reasoning for the
  # Stripe stub, which `apps/main` calls when somebody submits an entry.
  spawn timing "$PLATFORM/apps/timing" \
    npx --no-install opennextjs-cloudflare preview --port "$TIMING_PORT"
  wait_for "http://localhost:$TIMING_PORT/timing" "the timing Worker"
  info "timing  → :$TIMING_PORT"

  spawn stripe "$PLATFORM" node scripts/stripe-stub.mjs
  wait_for "http://127.0.0.1:$STRIPE_STUB_PORT/__stub/health" "the Stripe stub"
  info "stripe  → :$STRIPE_STUB_PORT (a stub — no real Stripe, no credentials)"

  spawn main "$PLATFORM/apps/main" \
    npm run preview
  wait_for "$SITE/" "the website"
  info "website → :$MAIN_PORT"

  STARTING_WORKERS=0
  ok "the site is up"
}

stop_workers() {
  local stopped=0
  for name in main timing stripe; do
    local pidfile="$RUN_DIR/$name.pid"
    [ -f "$pidfile" ] || continue
    local pid; pid="$(cat "$pidfile")"
    if kill -0 "$pid" 2>/dev/null; then
      # The npx wrapper spawns workerd as a child, so kill the group.
      kill -- "-$(ps -o pgid= "$pid" | tr -d ' ')" 2>/dev/null || kill "$pid" 2>/dev/null || true
      stopped=1
    fi
    rm -f "$pidfile"
  done

  # Belt and braces: this repository has been taken down once by processes that outlived
  # their parent, so a stray workerd is never left behind quietly.
  pkill -f "wrangler dev --port $MAIN_PORT" 2>/dev/null && stopped=1 || true
  pkill -f "opennextjs-cloudflare preview --port $TIMING_PORT" 2>/dev/null && stopped=1 || true
  pkill -f "scripts/stripe-stub.mjs" 2>/dev/null && stopped=1 || true
  sleep 1
  pkill -f workerd 2>/dev/null || true

  [ "$stopped" -eq 1 ] && ok "the site is stopped" || info "nothing was running"
}

open_browser() {
  case "$(uname -s)" in
    Darwin) open "$SITE/" 2>/dev/null || true ;;
    Linux)  xdg-open "$SITE/" >/dev/null 2>&1 || true ;;
  esac
}

remind_down() {
  printf '\n    %sThe database is still running in Docker.%s %s./dev down%s when you are finished.\n\n' \
    "$DIM" "$RESET" "$BOLD" "$RESET"
}

show_urls() {
  printf '\n    %sThe site%s\n' "$BOLD" "$RESET"
  printf '      %-38s the club website\n' "$SITE/"
  printf '      %-38s Nightingale Nightmare\n' "$SITE/nn/"
  printf '      %-38s race timing\n' "$SITE/timing"
  printf '      %-38s database studio\n' "http://localhost:54323"
  printf '\n    %s./dev down%s when you are finished.\n\n' "$DIM" "$RESET"
}

# ---------------------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------------------
cmd_up() {
  ensure_docker
  ensure_database
  build_site
  start_workers
  show_urls
  open_browser
}

cmd_test() {
  local keep_up=0
  [ "${1:-}" = "--keep-up" ] && keep_up=1

  ensure_docker
  ensure_database
  cmd_reset_quiet
  build_site

  # Both suites want the ports to themselves: the worker run starts its own Stripe stub on
  # 8789, and Playwright starts all three servers itself.
  stop_workers >/dev/null 2>&1 || true

  # ---------------------------------------------------------------------------------------
  # The Workers runtime, before the browsers
  # ---------------------------------------------------------------------------------------
  # Until this was here, `npm run test:worker` ran in CI and nowhere else — so a green run on
  # a laptop said nothing about the webhook handler, which is the code that decides whether a
  # runner's payment is recorded at all. That is the wrong thing to find out from a pull
  # request.
  #
  # **`test` rather than `check`**, because `check` is deliberately the fast loop — no
  # browsers, no builds — and these need `dist/` to exist, since the static-assets binding
  # serves from it. Putting them in `check` would mean adding a build to the command whose
  # whole point is not having one. `test` already builds.
  #
  # **Before Playwright**, which is the order ci.yml uses and for its reason: cheapest first,
  # so a failure here does not wait on three browser engines. It is also safe in the
  # direction that matters. Each of the four configs sets the `entries.events` state it needs
  # in `globalSetup` and puts it back in `teardown`, so the suite is robust to what preceded
  # it — while Playwright starts from the seed `cmd_reset_quiet` has just laid down and is
  # not. Running these second would mean a second reset to get that back.
  #
  # It is self-contained otherwise: it starts and stops its own fake Stripe, and needs no
  # Worker of ours running.
  step "Worker tests"
  info "96 tests, four Miniflare configs, the real Workers runtime — about 15s"

  local status=0
  (cd "$PLATFORM" && npm run test:worker) || status=$?

  if [ "$status" -ne 0 ]; then
    cmd_down
    die "the worker tests failed."
  fi
  ok "the worker suite passed"

  step "Acceptance tests"
  info "Playwright drives the servers itself — three browser projects, and a stubbed Stripe"

  (cd "$PLATFORM" && npx --no-install playwright test --reporter=list) || status=$?

  if [ "$keep_up" -eq 1 ]; then
    start_workers
    show_urls
  else
    # Everything down, including the database. A test run should leave the machine as it
    # found it — `./dev test --keep-up` is there for when you are iterating.
    cmd_down
  fi

  [ "$status" -eq 0 ] || die "the acceptance tests failed."
  ok "all tests passed"
}

cmd_check() {
  ensure_docker
  ensure_database

  step "Lint and format"
  (cd "$PLATFORM" && npm run lint)
  ok "clean"

  step "Types"
  (cd "$PLATFORM" && npm run typecheck >/dev/null)
  ok "no errors"

  step "Migrations stay inside club, intake and entries"
  (cd "$PLATFORM" && npm run db:migrations:check-scope >/dev/null)
  ok "no migration touches public or private"

  step "Unit and database tests"
  export_supabase_env
  (cd "$PLATFORM" && npm test)

  remind_down
}

cmd_smoke() {
  if [ "${1:-}" = "--live" ]; then
    step "Smoke testing the live site"
    info "https://new.southvillerunningclub.co.uk — up to five minutes, retrying while a"
    info "just-merged deploy catches up"
    (cd "$PLATFORM" && npm run smoke)
    return
  fi

  port_is_serving "$SITE/" || die "the site is not running. ./dev up first."
  (cd "$PLATFORM" && npm run smoke -- --local)
}

cmd_reset_quiet() {
  step "Resetting the database"
  info "migrations from zero, then the seed"
  (cd "$PLATFORM" && npm run db:reset >"$RUN_DIR/reset.log" 2>&1) \
    || { tail -20 "$RUN_DIR/reset.log"; die "the reset failed — see $RUN_DIR/reset.log"; }
  ok "schema rebuilt and seeded"
}

cmd_reset() { ensure_docker; ensure_database; cmd_reset_quiet; remind_down; }

cmd_down() {
  step "Stopping"
  stop_workers
  if (cd "$PLATFORM/packages/db" && npx --no-install supabase status >/dev/null 2>&1); then
    (cd "$PLATFORM" && npm run db:stop >/dev/null 2>&1) || true
    ok "the database is stopped"
  else
    info "the database was not running"
  fi
}

cmd_logs() { tail -f "$RUN_DIR"/main.log "$RUN_DIR"/timing.log "$RUN_DIR"/stripe.log; }

usage() {
  # The comment block at the top of this file is the help text, so the two cannot drift.
  # Stops at the first line that is not a comment.
  awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "${BASH_SOURCE[0]}"
  exit "${1:-0}"
}

case "${1:-up}" in
  -h|--help|help) usage 0 ;;
esac

check_prerequisites

case "${1:-up}" in
  up)     cmd_up ;;
  test)   shift; cmd_test "$@" ;;
  check)  cmd_check ;;
  smoke)  shift; cmd_smoke "$@" ;;
  reset)  cmd_reset ;;
  down)   cmd_down ;;
  logs)   cmd_logs ;;
  *)      printf '%sUnknown command:%s %s\n' "$RED" "$RESET" "$1" >&2; usage 1 ;;
esac
