#!/usr/bin/env bash
#
# The one command for working on this platform locally.
#
# It exists because the npm project lives in `platform/` while the repository root is
# documentation, so `npm run …` at the root finds nothing. Rather than asking everybody to
# remember a `cd`, this script knows where things are and does the whole job: Docker, the
# database, the seed, the builds, both Workers, and tidying up afterwards.
#
#   ./dev up        rebuild the database from migrations, then bring the site up and open it
#                   --keep-data skips the rebuild, when you know the schema is already current
#   ./dev test      run the worker and acceptance tests, then stop everything
#                   --keep-up leaves the site running afterwards
#   ./dev check     rebuild the database, then lint, types, unit and database tests
#                   — no browsers, no builds
#   ./dev smoke     the live-site assertions, against localhost
#                   --live checks the deployed site at new.southvillerunningclub.co.uk
#                   instead — the same check smoke.yml runs after every push to main
#   ./dev reset     rebuild the database from migrations and re-seed
#   ./dev down      stop the Workers and the database
#   ./dev logs      tail the running Workers
#
# Everything is idempotent. Running `up` twice is fine; so is `down` when nothing is up.
#
# **`test` and `check` write their whole transcript to `.dev/test.log`** and, on a failure,
# end by naming every test that failed. Neither runner does that on its own: both print the
# list and then keep printing — detail blocks, stack traces — so the end of a failing run is
# the end of *one* failure rather than a summary of all of them. Read the tail of a hundred
# failures and it looks like one. `.dev/` is gitignored; the file is the last run only.
#
# **`up`, `test` and `check` all mean the same thing by "the database": the schema this
# checkout's migrations describe.** They did not until recently — `up` and `check` started the
# stack and trusted whatever was on the volume, which `supabase start` only migrates when it
# creates one. A laptop that has run this project before therefore served the schema from
# whenever its volume was first made, and the way that surfaces is a 503 that names nothing.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLATFORM="$REPO_ROOT/platform"

# `config.toml`'s `[auth.captcha]` block (#53) reads `env(SUPABASE_AUTH_CAPTCHA_SECRET)`, and
# the Supabase CLI validates that substitution the moment `supabase start` runs — unset, the
# whole stack fails before a single test does. Defaulted here to Cloudflare's own published
# testing secret, "always passes", documented at
# developers.cloudflare.com/turnstile/troubleshooting/testing — never the club's real one.
# `:=` only fills a gap: exporting the real secret in your own shell first (to test the real
# Turnstile flow end to end) is respected rather than overridden.
: "${SUPABASE_AUTH_CAPTCHA_SECRET:=1x0000000000000000000000000000000AA}"
export SUPABASE_AUTH_CAPTCHA_SECRET

# `config.toml`'s `[auth.email.smtp]` block (#50) reads `env(SUPABASE_AUTH_SMTP_PASSWORD)`, and
# the CLI validates that substitution at `supabase start` exactly as it does the captcha
# secret above — unset, the whole stack fails before a single test does.
#
# ⚠️ **UNRESOLVED: whether a placeholder is safe here, and it is the one open question in
# #50.** Resend publishes no "always passes" testing credential, so unlike Turnstile above
# there is no correct value to default to — only a string that is obviously not a key.
#
# The premise is that `[local_smtp]` (Mailpit) intercepts every outgoing mail during
# `supabase start` whatever `[auth.email.smtp]` says, so nothing is ever dialled and the value
# is never used. **That premise is stated as fact in this repository's own documentation and
# by outside sources, and it did not hold in CI**: with the block enabled on port 465, every
# `auth.signUp()` in three database test files failed with `AuthRetryableFetchError … status:
# 500`, reproducibly across two runs, and #50's first attempt was reverted the same day.
#
# **Two candidate causes and nobody has separated them** — the blocked port, or GoTrue really
# dialling out with a fake password. `@supabase/auth-js` flattens both to the same bare 500,
# and neither `dev` nor `ci.yml` captures the GoTrue container's own log, which is where the
# answer is. **Settle that before this merges**: a full `supabase stop` and `start` against
# this config, one `signUp()`, then read the container log. If GoTrue does dial out, this line
# is wrong and the fix is a local mail catcher rather than a longer placeholder.
: "${SUPABASE_AUTH_SMTP_PASSWORD:=local-development-only-not-a-real-key}"
export SUPABASE_AUTH_SMTP_PASSWORD
RUN_DIR="$REPO_ROOT/.dev"

# The whole transcript of the last `test` or `check`, kept so a failure can be *read* rather
# than reconstructed from whatever happened to still be on screen. `.dev/` is gitignored, so
# this never reaches a commit.
#
# **It exists because a tail is the one part of a failing run guaranteed not to explain it.**
# Both runners print their list of failures and then keep going — Playwright follows it with
# per-failure detail blocks, vitest with stack traces — so the last hundred lines of a run
# with a hundred failures are the *end of one stack trace*. A run that failed 118 tests was
# read from its tail as a handful, and the fix was in neither the tail nor the summary.
TEST_LOG="$RUN_DIR/test.log"

MAIN_PORT=8787
TIMING_PORT=8788
# A fake Stripe. This repository holds no Stripe credentials, so the local site talks to
# `platform/scripts/stripe-stub.mjs` instead and the entry form works end to end on a laptop
# — a real POST, a real held place, a real 303 to a checkout.stripe.com address that nobody
# follows. `apps/main`'s `preview` script points STRIPE_API_BASE at this port.
STRIPE_STUB_PORT=8789
SITE="http://localhost:$MAIN_PORT"

mkdir -p "$RUN_DIR"

# Set for the duration of start_workers — a Ctrl-C or a failure partway through leaves
# whichever Worker had already started running, disowned and otherwise unkillable except
# by hand, unless something is watching for exactly that window.
STARTING_WORKERS=0

# ---------------------------------------------------------------------------------------
# Output. Plain enough to read in a CI log, clear enough to read at speed.
# ---------------------------------------------------------------------------------------
if [ -t 1 ]; then
  BOLD=$'\033[1m'; DIM=$'\033[2m'; GREEN=$'\033[32m'; RED=$'\033[31m'; RESET=$'\033[0m'
else
  BOLD=''; DIM=''; GREEN=''; RED=''; RESET=''
fi

step() { printf '\n%s==>%s %s%s\n' "$BOLD" "$RESET" "$BOLD" "$1$RESET"; }
info() { printf '    %s%s%s\n' "$DIM" "$1" "$RESET"; }
ok()   { printf '    %s✓%s %s\n' "$GREEN" "$RESET" "$1"; }

die() {
  printf '\n%serror%s %s\n\n' "$RED" "$RESET" "$1" >&2
  [ "$STARTING_WORKERS" -eq 1 ] && stop_workers >/dev/null 2>&1
  exit 1
}

# ---------------------------------------------------------------------------------------
# Running a suite, and saying afterwards what failed
# ---------------------------------------------------------------------------------------

# Start a fresh transcript. Called once per `test` or `check`, so the file is always the
# last run rather than every run this laptop has ever done.
begin_test_log() {
  : >"$TEST_LOG"
  printf 'The last ./dev %s, in full. Regenerated on every run; .dev/ is gitignored.\n' \
    "$1" >>"$TEST_LOG"
}

# Run a suite, live on screen and in full to the transcript.
#
# `tee` rather than a plain redirect, because a test run nobody can watch is a test run
# everybody assumes has hung — which is its own afternoon. `pipefail` is set at the top of
# this file, so the pipeline's status is the runner's and not `tee`'s (which always
# succeeds); without it every suite would appear to pass.
run_suite() {
  local label="$1"; shift
  printf '\n===== %s =====\n' "$label" >>"$TEST_LOG"
  (cd "$PLATFORM" && "$@") 2>&1 | tee -a "$TEST_LOG"
}

# Every failing test named in the transcript, once each.
#
# Two shapes, because there are two runners:
#
#   Playwright  `[chromium] › apps/main/tests/e2e/site.spec.ts:134:5 › describe › test`
#   vitest      `FAIL  packages/shared/tests/unit/brand.test.ts > describe > test`
#
# Playwright prints each failure twice — numbered above its detail block, bare in the closing
# summary — so the leading `N)` is stripped before `sort -u` collapses the pair. `|| true`
# because `grep`/`sort` finding nothing is a zero-failure run, not an error, and `set -e`
# would otherwise take the empty result as one.
failing_tests() {
  [ -f "$TEST_LOG" ] || return 0
  sed -n \
    -e 's/^[[:space:]]*[0-9]*)[[:space:]]*\(\[[a-z0-9_-]*\] › .*\)$/\1/p' \
    -e 's/^[[:space:]]*\(\[[a-z0-9_-]*\] › .*\)$/\1/p' \
    -e 's/^[[:space:]]*FAIL[[:space:]]\{1,\}\(.*[>›].*\)$/\1/p' \
    "$TEST_LOG" 2>/dev/null \
    | sed -e 's/[[:space:]]*$//' -e '/^$/d' \
    | sort -u || true
}

# The last thing on screen after a failure: what broke, and where to read the rest.
#
# Named in full rather than counted, because "118 failed" sends somebody back to the log to
# find out which — and a list of names is often enough to see the shape without opening it
# at all (three suites failing on one selector reads very differently from one suite failing
# on everything, which is a crashed server rather than a broken assertion).
report_failures() {
  local failures count
  failures="$(failing_tests)"

  if [ -z "$failures" ]; then
    # A suite can fail without naming a test — a runner that crashed, a server that never
    # came up. Say so, rather than printing an empty list that reads like "nothing failed".
    printf '\n%sno individual test was named — the runner itself failed.%s\n' "$BOLD" "$RESET" >&2
    printf '    the whole run: %s\n' "$TEST_LOG" >&2
    return
  fi

  count="$(printf '%s\n' "$failures" | wc -l | tr -d ' ')"
  printf '\n%s%s failed:%s\n' "$BOLD" "$count" "$RESET" >&2
  printf '%s\n' "$failures" | sed 's/^/    /' >&2
  printf '\n    the whole run, with the stack traces: %s\n' "$TEST_LOG" >&2
}

# A Ctrl-C mid-startup means "cancel this", not "leave whatever came up running" — the
# opposite of what `disown` is there for once startup has actually finished.
interrupted() {
  [ "$STARTING_WORKERS" -eq 1 ] && stop_workers >/dev/null 2>&1
  exit 130
}
trap interrupted INT TERM

# ---------------------------------------------------------------------------------------
# Prerequisites. `supabase`, `wrangler` and everything else this script calls are local
# devDependencies invoked bare from npm scripts — npm puts platform/node_modules/.bin on
# PATH for the duration of `npm run`, which only exists once `npm install` has been run
# there. `./dev` is meant to be the single touch point, so it runs that install itself
# rather than sending someone to a second command — but only node and npm themselves are
# left for a human, since there is no safe way to install a language runtime for them.
# ---------------------------------------------------------------------------------------
check_prerequisites() {
  step "Checking prerequisites"

  command -v node >/dev/null 2>&1 || die "node is not installed. It is required to run
    anything in platform/. Install it — nodejs.org, or a version manager such as nvm —
    matching the version in platform/.nvmrc."

  command -v npm >/dev/null 2>&1 || die "npm is not installed. It ships with node normally;
    if node is present but npm is not, reinstall node from nodejs.org or your version
    manager."

  # A stale install is treated the same as a missing one. Comparing package-lock.json
  # alone misses the case of a hand-edited package.json that nobody has run `npm install`
  # against yet — an every-workspace `add a dependency` is exactly that — so the stamp is
  # checked against every package.json in the workspace, not just the lockfile.
  local stamp="$PLATFORM/node_modules/.dev-install-stamp"
  local needs_install=0
  [ -d "$PLATFORM/node_modules" ] || needs_install=1
  [ -x "$PLATFORM/node_modules/.bin/supabase" ] || needs_install=1
  [ -f "$stamp" ] || needs_install=1
  if [ "$needs_install" -eq 0 ]; then
    [ "$PLATFORM/package-lock.json" -nt "$stamp" ] && needs_install=1
    find "$PLATFORM" -name package.json -not -path '*/node_modules/*' -newer "$stamp" \
      2>/dev/null | grep -q . && needs_install=1
  fi

  if [ "$needs_install" -eq 1 ]; then
    step "Installing dependencies"
    (cd "$PLATFORM" && npm install >"$RUN_DIR/install.log" 2>&1) \
      || { tail -30 "$RUN_DIR/install.log"; die "npm install failed — see $RUN_DIR/install.log"; }
    touch "$stamp"
    ok "dependencies installed"
  fi

  ok "node, npm and project dependencies are present"
}

# ---------------------------------------------------------------------------------------
# Docker, and waiting for it properly
# ---------------------------------------------------------------------------------------
ensure_docker() {
  if docker info >/dev/null 2>&1; then
    ok "Docker is running"
    return
  fi

  command -v docker >/dev/null 2>&1 || die "Docker is not installed. It is required: the
    local stack is a real Postgres, which is the only way row-level security can be
    tested rather than mocked."

  step "Starting Docker"
  case "$(uname -s)" in
    Darwin) open -a Docker 2>/dev/null || die "Could not start Docker Desktop. Start it by hand." ;;
    *)      die "Docker is not running. Start it, then try again." ;;
  esac

  info "waiting for the daemon (this takes a minute on a cold start)"
  local waited=0
  until docker info >/dev/null 2>&1; do
    sleep 2
    waited=$((waited + 2))
    [ "$waited" -lt 120 ] || die "Docker did not start within two minutes."
  done
  ok "Docker is running"
}

# The one failure worth recovering from automatically, and the signature is unambiguous.
#
# **A volume older than the branch cannot be reset, because the reset never gets to run.** The
# stack has to be *up* before `supabase db reset` can touch it, and this is the case where it
# never comes up: a schema in `config.toml`'s exposed list that the volume has not got. Postgres
# answers `3F000`, PostgREST cannot build a schema cache, retries at 8s and 16s, and the CLI
# tears the whole stack down with a health-check 503 naming the REST container. Nothing in that
# output says "your volume predates this branch", which is why it cost a reviewer an afternoon.
#
# Both halves are required before touching anything: `3F000` alone is any missing schema, and a
# REST 503 alone is any number of ordinary startup problems. Together they are this and only
# this.
database_volume_is_stale() {
  grep -q '"code":"3F000"' "$RUN_DIR/db.log" 2>/dev/null &&
    grep -q 'supabase_rest[^"]*: unexpected status 503' "$RUN_DIR/db.log" 2>/dev/null
}

start_database() {
  (cd "$PLATFORM" && npm run db:start >"$RUN_DIR/db.log" 2>&1)
}

ensure_database() {
  # `supabase status` is the honest check — containers can exist but not be serving.
  if (cd "$PLATFORM/packages/db" && npx --no-install supabase status >/dev/null 2>&1); then
    ok "the database is up"
    return
  fi

  step "Starting the database"
  info "Postgres, auth, storage and Studio, in Docker"

  if start_database; then
    ok "the database is up"
    return
  fi

  if ! database_volume_is_stale; then
    tail -20 "$RUN_DIR/db.log"
    die "the database did not start — see $RUN_DIR/db.log"
  fi

  # Once, and never in a loop: if a fresh volume cannot start either, the problem is not the
  # volume and a second attempt would only bury the real error under a longer log.
  step "The database volume is older than this branch"
  info "PostgREST asked for a schema this volume has not got, so the stack never went healthy."
  info "\`supabase start\` migrates a volume only when it creates one, so a machine that has"
  info "run this project before keeps whatever schema it first had. Rebuilding it — the only"
  info "thing on it is the seed and invented fixtures."

  (cd "$PLATFORM/packages/db" && npx --no-install supabase stop --no-backup >/dev/null 2>&1) || true

  start_database \
    || { tail -20 "$RUN_DIR/db.log"; die "the database did not start on a fresh volume either
    — this is not the stale-volume case. See $RUN_DIR/db.log"; }

  ok "the database is up, on a volume rebuilt from this checkout's migrations"
}

# `packages/db/tests` reads SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_DB_URL — the anon
# client checks what can be *reached*, the privileged DB_URL connection checks what is *in*
# a table, and testing an access boundary from one side only proves half of it. `ci.yml`
# exports the same three from `supabase status -o env`; this mirrors it so `./dev check`
# does not just advertise the database tests but actually runs them.
export_supabase_env() {
  local env_output
  env_output="$(cd "$PLATFORM/packages/db" && npx --no-install supabase status -o env)"
  export SUPABASE_URL SUPABASE_ANON_KEY SUPABASE_DB_URL
  SUPABASE_URL="$(printf '%s\n' "$env_output" | grep '^API_URL=' | cut -d= -f2- | tr -d '"')"
  SUPABASE_ANON_KEY="$(printf '%s\n' "$env_output" | grep '^ANON_KEY=' | cut -d= -f2- | tr -d '"')"
  SUPABASE_DB_URL="$(printf '%s\n' "$env_output" | grep '^DB_URL=' | cut -d= -f2- | tr -d '"')"
}

# ---------------------------------------------------------------------------------------
# Builds. Deliberately separate commands: `build` produces the Next.js output that OpenNext
# then bundles, and merging them makes OpenNext invoke itself. See apps/timing/README.md.
# ---------------------------------------------------------------------------------------
build_site() {
  step "Building"
  info "apps/main — static Astro"
  (cd "$PLATFORM" && npm run build >"$RUN_DIR/build.log" 2>&1) \
    || { tail -30 "$RUN_DIR/build.log"; die "the build failed — see $RUN_DIR/build.log"; }
  info "apps/timing — the OpenNext Worker bundle"
  (cd "$PLATFORM" && npm run build:worker >>"$RUN_DIR/build.log" 2>&1) \
    || { tail -30 "$RUN_DIR/build.log"; die "the Worker bundle failed — see $RUN_DIR/build.log"; }
  ok "both applications built"
}

# ---------------------------------------------------------------------------------------
# The Workers
# ---------------------------------------------------------------------------------------
port_is_serving() { curl -sf -o /dev/null --max-time 2 "$1" 2>/dev/null; }

wait_for() {
  local url="$1" name="$2" waited=0
  until port_is_serving "$url"; do
    sleep 1
    waited=$((waited + 1))
    [ "$waited" -lt 90 ] || die "$name did not come up within 90s."
  done
}

# Start a long-running server and **fully detach it**, so `./dev up` returns to the prompt.
#
# All three streams are redirected and stdin is closed: a child that still holds the
# terminal keeps the shell waiting for it, which is exactly what `up` must not do. `disown`
# then removes it from this shell's job table so no exit trap can reap it.
spawn() {
  local name="$1" dir="$2"; shift 2
  (
    cd "$dir" || exit 1
    nohup "$@" >"$RUN_DIR/$name.log" 2>&1 </dev/null &
    echo $! >"$RUN_DIR/$name.pid"
    disown
  )
}

start_workers() {
  step "Starting the site"

  if port_is_serving "$SITE/"; then
    ok "already running at $SITE"
    return
  fi

  STARTING_WORKERS=1

  # `apps/timing` first: `apps/main` forwards /timing to it, so starting the other way
  # round gives a window where the site is up and /timing 502s. Same reasoning for the
  # Stripe stub, which `apps/main` calls when somebody submits an entry.
  spawn timing "$PLATFORM/apps/timing" \
    npx --no-install opennextjs-cloudflare preview --port "$TIMING_PORT"
  wait_for "http://localhost:$TIMING_PORT/timing" "the timing Worker"
  info "timing  → :$TIMING_PORT"

  spawn stripe "$PLATFORM" node scripts/stripe-stub.mjs
  wait_for "http://127.0.0.1:$STRIPE_STUB_PORT/__stub/health" "the Stripe stub"
  info "stripe  → :$STRIPE_STUB_PORT (a stub — no real Stripe, no credentials)"

  spawn main "$PLATFORM/apps/main" \
    npm run preview
  wait_for "$SITE/" "the website"
  info "website → :$MAIN_PORT"

  STARTING_WORKERS=0
  ok "the site is up"
}

stop_workers() {
  local stopped=0
  for name in main timing stripe; do
    local pidfile="$RUN_DIR/$name.pid"
    [ -f "$pidfile" ] || continue
    local pid; pid="$(cat "$pidfile")"
    if kill -0 "$pid" 2>/dev/null; then
      # The npx wrapper spawns workerd as a child, so kill the group.
      kill -- "-$(ps -o pgid= "$pid" | tr -d ' ')" 2>/dev/null || kill "$pid" 2>/dev/null || true
      stopped=1
    fi
    rm -f "$pidfile"
  done

  # Belt and braces: this repository has been taken down once by processes that outlived
  # their parent, so a stray workerd is never left behind quietly.
  pkill -f "wrangler dev --port $MAIN_PORT" 2>/dev/null && stopped=1 || true
  pkill -f "opennextjs-cloudflare preview --port $TIMING_PORT" 2>/dev/null && stopped=1 || true
  pkill -f "scripts/stripe-stub.mjs" 2>/dev/null && stopped=1 || true
  sleep 1
  pkill -f workerd 2>/dev/null || true

  [ "$stopped" -eq 1 ] && ok "the site is stopped" || info "nothing was running"
}

open_browser() {
  case "$(uname -s)" in
    Darwin) open "$SITE/" 2>/dev/null || true ;;
    Linux)  xdg-open "$SITE/" >/dev/null 2>&1 || true ;;
  esac
}

remind_down() {
  printf '\n    %sThe database is still running in Docker.%s %s./dev down%s when you are finished.\n\n' \
    "$DIM" "$RESET" "$BOLD" "$RESET"
}

show_urls() {
  printf '\n    %sThe site%s\n' "$BOLD" "$RESET"
  printf '      %-38s the club website\n' "$SITE/"
  printf '      %-38s Nightingale Nightmare\n' "$SITE/nn/"
  printf '      %-38s race timing\n' "$SITE/timing"
  printf '      %-38s database studio\n' "http://localhost:54323"
  printf '\n    %s./dev down%s when you are finished.\n\n' "$DIM" "$RESET"
}

# ---------------------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------------------
# **The reset is the point of the change, not a tidy-up.** `ensure_database` starts the stack
# and returns; `supabase start` runs migrations only when it initialises a *fresh* volume. So
# without this, `up` served whatever schema the volume was created with, and a branch that adds
# to `config.toml`'s exposed schemas — this one adds `entries` — takes PostgREST down with a
# 503 that points nowhere near the cause.
#
# It costs tens of seconds on every `up`, and the local data goes with it. That data is the
# seed and invented fixtures: this repository's rule is that no production data is ever on a
# laptop, so there is nothing on the volume worth keeping. `--keep-data` is there for the
# middle of a session where the schema is known to be current — the exception, not the habit.
cmd_up() {
  local keep_data=0
  [ "${1:-}" = "--keep-data" ] && keep_data=1

  ensure_docker
  ensure_database
  if [ "$keep_data" -eq 1 ]; then
    info "--keep-data: leaving the database as it is"
  else
    cmd_reset_quiet
  fi
  build_site
  start_workers
  show_urls
  open_browser
}

cmd_test() {
  local keep_up=0
  [ "${1:-}" = "--keep-up" ] && keep_up=1

  ensure_docker
  ensure_database
  cmd_reset_quiet
  build_site
  begin_test_log test

  # Both suites want the ports to themselves: the worker run starts its own Stripe stub on
  # 8789, and Playwright starts all three servers itself.
  stop_workers >/dev/null 2>&1 || true

  # ---------------------------------------------------------------------------------------
  # The Workers runtime, before the browsers
  # ---------------------------------------------------------------------------------------
  # Until this was here, `npm run test:worker` ran in CI and nowhere else — so a green run on
  # a laptop said nothing about the webhook handler, which is the code that decides whether a
  # runner's payment is recorded at all. That is the wrong thing to find out from a pull
  # request.
  #
  # **`test` rather than `check`**, because `check` is deliberately the fast loop — no
  # browsers, no builds — and these need `dist/` to exist, since the static-assets binding
  # serves from it. Putting them in `check` would mean adding a build to the command whose
  # whole point is not having one. `test` already builds.
  #
  # **Before Playwright**, which is the order ci.yml uses and for its reason: cheapest first,
  # so a failure here does not wait on three browser engines. It is also safe in the
  # direction that matters. Each of the five configs sets the `entries.events` state it needs
  # in `globalSetup` and puts it back in `teardown`, so the suite is robust to what preceded
  # it — while Playwright starts from the seed `cmd_reset_quiet` has just laid down and is
  # not. Running these second would mean a second reset to get that back.
  #
  # It is self-contained otherwise: it starts and stops its own fake Stripe, and needs no
  # Worker of ours running.
  #
  # **`export_supabase_env` is called here too, and it did not used to need to be.** Every
  # `globalSetup` before #58 spoke to Postgres directly with `pg`, which only ever needed
  # `SUPABASE_DB_URL` — hardcoded as a fallback in `admin-db.ts`, since the local connection
  # string never changes. The admin config's setup now also signs three fixture people up
  # through the real `/account/sign-up/` path, which is a Supabase client and genuinely needs
  # `SUPABASE_URL` and `SUPABASE_ANON_KEY`, and those have no safe default to fall back to.
  # `ci.yml` writes the same three to `$GITHUB_ENV` once, early, so every later step —
  # including this one — already inherits them; this mirrors that rather than introducing
  # something CI does not already do.
  step "Worker tests"
  info "five Miniflare configs, the real Workers runtime — about 15s"

  export_supabase_env
  local status=0
  run_suite 'Worker tests' npm run test:worker || status=$?

  if [ "$status" -ne 0 ]; then
    report_failures
    cmd_down
    die "the worker tests failed."
  fi
  ok "the worker suite passed"

  step "Acceptance tests"
  info "Playwright drives the servers itself — three browser projects, and a stubbed Stripe"

  # **Two runs, not one.** `nn-entry.spec.ts` and `nn-signup.spec.ts` share
  # `entries.events.entries_open_at` and must not run on different workers at once;
  # `playwright.config.serial.ts` is those two files alone, at `workers: 1`. Everything else
  # is `playwright.config.ts`'s own default config, which is free to use more than one worker
  # now that it no longer has that race to protect against. See either file's header.
  run_suite 'Acceptance tests (serial)' \
    npx --no-install playwright test --config=playwright.config.serial.ts --reporter=list \
    || status=$?
  run_suite 'Acceptance tests' npx --no-install playwright test --reporter=list || status=$?

  if [ "$keep_up" -eq 1 ]; then
    start_workers
    show_urls
  else
    # Everything down, including the database. A test run should leave the machine as it
    # found it — `./dev test --keep-up` is there for when you are iterating.
    cmd_down
  fi

  if [ "$status" -ne 0 ]; then
    report_failures
    die "the acceptance tests failed."
  fi
  ok "all tests passed"
  info "the whole run: $TEST_LOG"
}

cmd_check() {
  ensure_docker
  ensure_database
  # **The worse version of the same hole.** `up` failing loudly is survivable; this passes.
  # The database tests would run against whatever schema the volume happened to hold and
  # report success, so a green `./dev check` could mean "green against a schema this branch
  # does not have" — which is the one thing a check command must never be able to mean.
  cmd_reset_quiet
  begin_test_log check

  step "Lint and format"
  (cd "$PLATFORM" && npm run lint)
  ok "clean"

  step "Types"
  (cd "$PLATFORM" && npm run typecheck >/dev/null)
  ok "no errors"

  step "Migrations stay inside club, intake and entries"
  (cd "$PLATFORM" && npm run db:migrations:check-scope >/dev/null)
  ok "no migration touches public or private"

  step "Unit and database tests"
  export_supabase_env
  local status=0
  run_suite 'Unit and database tests' npm test || status=$?
  if [ "$status" -ne 0 ]; then
    report_failures
    die "the unit and database tests failed."
  fi
  info "the whole run: $TEST_LOG"

  remind_down
}

cmd_smoke() {
  if [ "${1:-}" = "--live" ]; then
    step "Smoke testing the live site"
    info "https://new.southvillerunningclub.co.uk — up to five minutes, retrying while a"
    info "just-merged deploy catches up"
    (cd "$PLATFORM" && npm run smoke)
    return
  fi

  port_is_serving "$SITE/" || die "the site is not running. ./dev up first."
  (cd "$PLATFORM" && npm run smoke -- --local)
}

cmd_reset_quiet() {
  step "Resetting the database"
  info "migrations from zero, then the seed"
  (cd "$PLATFORM" && npm run db:reset >"$RUN_DIR/reset.log" 2>&1) \
    || { tail -20 "$RUN_DIR/reset.log"; die "the reset failed — see $RUN_DIR/reset.log"; }
  ok "schema rebuilt and seeded"
}

cmd_reset() { ensure_docker; ensure_database; cmd_reset_quiet; remind_down; }

cmd_down() {
  step "Stopping"
  stop_workers
  if (cd "$PLATFORM/packages/db" && npx --no-install supabase status >/dev/null 2>&1); then
    (cd "$PLATFORM" && npm run db:stop >/dev/null 2>&1) || true
    ok "the database is stopped"
  else
    info "the database was not running"
  fi
}

cmd_logs() { tail -f "$RUN_DIR"/main.log "$RUN_DIR"/timing.log "$RUN_DIR"/stripe.log; }

usage() {
  # The comment block at the top of this file is the help text, so the two cannot drift.
  # Stops at the first line that is not a comment.
  awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "${BASH_SOURCE[0]}"
  exit "${1:-0}"
}

case "${1:-up}" in
  -h|--help|help) usage 0 ;;
esac

check_prerequisites

case "${1:-up}" in
  # `up` is the default with no arguments at all, so there may be nothing to shift — and a
  # `shift` on an empty list is a non-zero return, which `set -e` would take as a failure.
  up)     if [ "$#" -gt 0 ]; then shift; fi; cmd_up "$@" ;;
  test)   shift; cmd_test "$@" ;;
  check)  cmd_check ;;
  smoke)  shift; cmd_smoke "$@" ;;
  reset)  cmd_reset ;;
  down)   cmd_down ;;
  logs)   cmd_logs ;;
  *)      printf '%sUnknown command:%s %s\n' "$RED" "$RESET" "$1" >&2; usage 1 ;;
esac
